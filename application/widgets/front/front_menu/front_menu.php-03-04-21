<?php defined('BASEPATH') OR exit('No direct script access allowed');

/**
 * 
 */
class Front_menu extends Widget
{
	
	function run($visible = FALSE) {
		$this->front_theme='default';
    	$this->get_type(2);

        $slug_1=$this->uri->segment(1,0);//country

        if($slug_1!='0'){
            $country=$this->com->get_country(array('country_iso_code_2'=>strtoupper($slug_1)));
            if(!empty($country)){
                $country_id=$country->country_id;
            }else{
                $country_id=$this->data['default_country_data']->country_id;                
            }
        }else{
            $country_id=$this->data['default_country_data']->country_id;
        }


        $country_data=$this->com->get_country(array('country_id'=>$country_id));
        $country_name=strtoupper($country_data->country_name);

    	$top_menues=$this->sm->get_menues(array('menu_is_top'=>'1','menu_is_active'=>'1','menu_parent_id'=>'0'),FALSE,'menu_serial','ASC',FALSE);

        //print_obj($top_menues);die;

        $main_menues=array();
        $featured_colleges_data=array();
        $featured_college_heading='';

    	if(!empty($top_menues)){
    		foreach ($top_menues as $key => $value) {
                $top_menu_id=$value->menu_id;
    			$sub_menues=$this->sm->get_menues(array('menu_is_top'=>'2','menu_is_active'=>'1','menu_parent_id'=>$value->menu_id),FALSE); 

                $sub_menues_data=array();             

    			if(!empty($sub_menues)){
    			   	foreach ($sub_menues as $k => $v) {

                       $sub_menues_data_2=array();                       

                       $menu_columns=$this->sm->get_menue_columns(array('menu_column_parent_id'=>$v->menu_id),FALSE);                       

                        if(!empty($menu_columns)){
                            foreach ($menu_columns as $__k => $__v) {
                                $sub_menues_column_data_2=array();

                                if($__v->menu_column_has_menu=='1'){
                                    $sub_menues_2=$this->sm->get_menues(array('menu_is_top'=>'2','menu_is_active'=>'1','menu_parent_id'=>$__v->menu_column_parent_id,'menu_column_id'=>$__v->menu_column_id),FALSE);

                                    foreach ($sub_menues_2 as $_k => $_v) {
                                        $sub_menues_column_data_2[]=array(
                                            'menu_name'=>$_v->menu_name,
                                            'menu_link'=>$_v->menu_link                           
                                        );
                                    }

                                    if($__v->menu_column_has_menu=='0'){
                                        $column_width='6';
                                    }else if($__v->menu_column_has_menu=='1'){
                                        $column_width=$__v->menu_column_no;
                                    }else if($__v->menu_column_has_menu=='2'){
                                        $column_width='4';
                                    }

                                    $sub_menues_data_2[]=array(
                                        'menu_column'=>$__v->menu_column_name,
                                        'menu_column_width'=>$column_width,
                                        'sub_menues'=>$sub_menues_column_data_2                                                                   
                                    );
                                }
                                    
                            }
                        }                       

                       $sub_menues_data[]=array(
                           'menu_name'=>$v->menu_name,
                           'sub_menues'=>$sub_menues_data_2
                       );
                    }	
    			}

    			$main_menues['menues'][]=array(
    				'menu_name'=>$value->menu_name,
                    'menu_link'=>$value->menu_link,
    				'sub_menues'=>$sub_menues_data                    
    			);


                //$featured_colleges=$this->um->get_listing_package_users(array('listing_package_type_id'=>$top_menu_id,'listing_package_type'=>'TOP_MENU_WISE','college_is_featured_visible_in_menu'=>'1','college_is_featured'=>'1'),FALSE,null,'DESC',FALSE);

                //print_obj($featured_colleges);

                // if(!empty($featured_colleges)){

                //     $featured_college_heading='FEATURED '.strtoupper($value->menu_name).' COLLEGES IN '.$country_name;

                //     foreach ($featured_colleges as $key => $value) {

                //         $college_city=$this->com->get_city(array('city_id'=>$value->college_city_id));
                //         $college_state=$this->com->get_state(array('state_id'=>$value->college_state_id));

                //         $college_address=ucwords($college_city->city_name).','.ucwords($college_state->state_name);


                //         $college_logo=$this->sm->get_user_file(array('user_file_type_id'=>$value->college_user_id,'user_storage_type'=>'user_logo'));

                //         if(!empty($college_logo) && !empty($college_logo->media_disk_path_relative)){
                //             $college_logo=$college_logo->media_disk_path_relative;
                //         }else{
                //             $college_logo=base_url().'uploads/app/default/no.jpg';
                //         }

                //         $featured_colleges_data[]=array(
                //             'college_name'=>ucwords($value->college_name),
                //             'college_address'=>$college_address,
                //             'college_logo'=>$college_logo,
                //             'college_link'=>$value->access_url
                //         );
                //     }                                    
                // }
    		}
    	}

       
        //die;

    	$data['top_menues']=$main_menues;
        $data['top_menu_featured_colleges_heading']=$featured_college_heading;
        $data['top_menu_featured_colleges_data']=$featured_colleges_data;

        if ($visible) $this->render('front_menu',$data);
    }
}