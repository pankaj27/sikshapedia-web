									'user_password_visible'=>encode_data($register_college_password),
									'user_blocked'=>'1',
									'user_approved'=>'2',
									'user_email_verified'=>'2',
									'user_phone_no_verified'=>'2',
									'user_otp'=>$otp,
									'user_mail_otp'=>$mail_otp,
									'user_top_sent_date'=>date('Y-m-d H:i:s'),
									'created_by'=>'0',
									'created_by_type'=>'4',
									'user_created_through'=>'1',
									'user_sent_from'=>'normal',
									'user_otp_sent_count'=>'1',
									'user_registration_type'=>'self',					
									'user_currency'=>($country_data->country_currency!='')?$country_data->country_currency:'4'
								);

								$user_pk_id=$this->um->add_user_data($college_user_data,FALSE,FALSE);

								if($user_pk_id){
									$this->im->update_college_data(array('college_user_id'=>$user_pk_id),array('college_id'=>$user_profile_pk_id));
									$_slug_value=$register_college_name.' '.$city_data->city_name.' '.$state_data->state_name;
									$slug_value=url_slug($_slug_value);
									$slug_url=base_url().strtolower($country_data->country_iso_code_2).'/'.$slug_value;
									$folder_name=$slug_value;

									$slug_found=$this->sm->get_slug(array('slug_type_id'=>$user_pk_id,'slug_type'=>'7'));

									if(empty($slug_found)){
										$inserted=$this->sm->store_slug(array('slug_value'=>$slug_value,'slug_type_id'=>$user_pk_id,'slug_type'=>'7'));
										if($inserted){
											$this->im->update_college_data(array('access_url'=>$slug_url,'access_url_slug'=>$slug_value),array('college_user_id'=>$user_pk_id));
										}
									}



									$sms_data=array(
										'flow_id'=>"61246d38163f8d707f23807f",
										'sender'=>"NCRIPT",
										'mobiles'=>$country_data->country_phone_code.$register_college_contact_phone_no,
										'user_name'=>$college_short_name,
										'otp_code'=>$otp,
										'web_link'=>'signin'
									);

									$sms_param['url']='https://api.msg91.com/api/v5/flow/';
									$sms_param['headers']=array("authkey: 197850AFrGnNLUa5a816402","content-type: application/JSON");
									$sms_param['data']=$sms_data;


									//print_obj($sms_param);
									

									$v_link=base_url().'verify/'.encode_data($inserted);
									$mail_data['protocol']='smtp';
									$mail_data['smtp_host']='host.waytoadmissions.com';
						            $mail_data['password']='InfoWaytoadmin@123%';

									$mail_data['from']=$this->data['system_info_email'];
									$mail_data['from_name']=$this->data['system_name_title'];
									$mail_data['to']=$register_college_contact_email;
									$mail_data['subject']='Account registration Verfication';
									$mail_data['data']=array(
