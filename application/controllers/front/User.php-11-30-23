								}
								
							}else if($data_update_type=='profile_image'){

								//echo 'hi';die;
								if(isset($_FILES['profile_pic']) && $_FILES['profile_pic']['name']!=''){
									$file_logo_found=$this->sm->get_user_file(array('user_storage_type'=>'user_image','user_file_type_id'=>$user_id));

									if(!empty($file_logo_found)){
										if(is_file($file_logo_found->media_disk_path)){
											@unlink($file_logo_found->media_disk_path);
											$this->sm->delete_file(array('storage_id'=>$file_logo_found->storage_id));
										}
									}

									$user_image_data=array(
										'file_size'=>'5',
										'file_name'=>'profile_pic',
										'file_types'=>'png,jpg,jpeg',
										'file_folder'=>'users',
										'file_child_folder'=>date('Y'),
										'file_uploaded_by'=>$user_id,
										'file_compress'=>true,
										'file_compress_protocol'=>'webp'
									);

									$file_id=$this->onUploadFiles($user_image_data);

									if(!empty($file_id) && is_numeric($file_id) && $file_id>0){

										$this->sm->delete_user_file(array('user_file_type_id'=>$user_id,'user_storage_type'=>'user_image'));

							            $user_image_storage_data=array(
							            	'user_file_storage_id'=>$file_id,
							            	'user_file_type_id'=>$user_id,
							            	'user_file_type'=>$user_data->user_role,
							            	'user_storage_type'=>'user_image'
							            );

							            $this->sm->store_user_file($user_image_storage_data);

							            $response_success.='Profile image updated successfully';
							        }else{
							        	$response_error.='Profile Image not updated';
							        }

								}else{
									$response_error.='Image not found.';
								}
							}
						}else{
							$response_error.='Data not found in the system.';
						}
					}
				}
				else{
					$response_error.='Data error';
				}				


				if($response_success!=''){
					$return['success']=$response_success;
				}else{
					$return['error']=$response_error;
				}

				header('Content-Type: application/json');

				echo json_encode($return);
			}else{
				redirect(base_url());
			}
		}else{
			redirect(base_url());
		}			
	}



	public function onShortlistInstitutes(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){
			if(session_userdata('isUserLoggedin')==TRUE && session_userdata('user_id')){

				$inst=post_data('inst');
				$user_id=decode_data(session_userdata('user_id'));
				$insttype=post_data('inst_type');

				$inst_id=decode_data($inst);
				$inst_type=decode_data($insttype);


				$data_fond=$this->im->get_inst_shortlist_data(array('shortlist_inst_type'=>$inst_type,'shortlist_inst_type_id'=>$inst_id,'shortlist_user_id'=>$user_id));

				if(empty($data_found)){
					$inserted=$this->im->add_inst_shortlist_data(array('shortlist_inst_type'=>$inst_type,'shortlist_inst_type_id'=>$inst_id,'shortlist_user_id'=>$user_id));
				}else{
					$inserted=$this->im->update_inst_shortlist_data(array('shortlist_inst_type'=>$inst_type,'shortlist_inst_type_id'=>$inst_id,'shortlist_user_id'=>$user_id),array('shortlist_id'=>$data_found->shortlist_id));
				}

				if($inserted){
					$return['success']='You have shortlisted successfully';
				}else{
					$return['error']='There is an error occurred';
				}

				header('Content-Type: application/json');

				echo json_encode($return);

			}else{
				redirect(base_url());
			}
		}else{
			redirect(base_url());
		}
	}



	//Get Applied Colleges
	public function onGetAppliedColleges(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){
			if(session_userdata('isUserLoggedin')==TRUE && session_userdata('user_id')){

				$user_id=decode_data(session_userdata('user_id'));

				$colleges=array();

				$get_applicat_colleges=$this->um->_get_applicant(array('applicant_id'=>$user_id),FALSE);

				if(!empty($get_applicat_colleges)){
					foreach ($get_applicat_colleges as $key => $value) {
						$state=$this->cm->get_state_specific('state_id,state_name',array('state_id'=>$value->college_state_id));
						$city=$this->cm->__get_city('city_id,city_name',array('city_id'=>$value->college_city_id));
						$_college_logo=$this->sm->get_user_file(array('user_file_type_id'=>$value->college_user_id,'user_storage_type'=>'user_logo','user_file_type'=>'4'));
						if(!empty($_college_logo) && !empty($_college_logo->media_disk_path_relative)){
		                    $college_logo=$_college_logo->media_disk_path_relative;
		                    $college_logo_name=$_college_logo->media_org_name;
		                }else{
		                    $college_logo=base_url().'uploads/app/default/no.jpg';
		                    $college_logo_name='';
		                }

						$colleges[]=array(
							'college_name'=>$value->college_name,
							'college_logo'=>$college_logo,
							'college_url'=>$value->access_url,
							'college_country_state_city'=>$city->city_name.','.$state->state_name,
							'application_date'=>date('j M, Y',strtotime($value->application_date))
						);
					}
				}

				$this->data['colleges']=$colleges;

				$return['html']=$this->theme->view('_pages/account/student/vw_profile_student_applied_colleges',$this->data,true);

				header('Content-Type: application/json; charset=utf-8');
				echo json_encode($return);

			}else{
				redirect(base_url());
			}
		}else{
			redirect(base_url());
		}
	}


}

