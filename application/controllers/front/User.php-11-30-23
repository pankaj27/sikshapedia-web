	//University Page

	public function indexUniversityRegisterPage(){
		if(!session_userdata('isUserLoggedin') && !session_userdata('user_id')){
			$segment_1=$this->uri->segment(1,0);//signup
			$segment_2=$this->uri->segment(2,0);//"colleges"

			if((is_string($segment_1) && ($segment_1!='0' && $segment_1=='signup')) && (is_string($segment_2) && ($segment_2!='0' && $segment_2=='university'))){

				$institue_types=$this->im->get_institute_types(array('inst_data_type'=>'3'),FALSE);

				if(!empty($institue_types)){
					foreach ($institue_types as $key => $value) {					
						$selected=(isset($college_data) && !empty($college_data) && ($college_data->user_type==$value->inst_type))?'selected':'';
						$_institue_types[]=array(
							'inst_type'=>encode_data($value->inst_type),
							'inst_type_name'=>$value->inst_type_name,
							'selected'=>$selected
						);
					}
				}else{
					$_institue_types=array();
				}

				$this->data['institue_types']=$_institue_types;

				$page_title=$this->data['page_title'];
				$view_page='account/university/vw_register_university_page';

				$this->theme->title($page_title)->load($view_page, $this->data);

			}else{
				redirect(base_url());
			}
		}else{
			redirect(base_url().'account/settings');
		}
			
	}

	public function onRegisterUniversity(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){

			$register_university_name=post_data('register_university_name');
			$register_university_email=post_data('register_university_email');
			$register_university_phone_no=post_data('register_university_phone_no');
			$register_university_country=post_data('register_university_country');
			$register_university_state=post_data('register_university_state');
			$register_university_district=post_data('register_university_district');
			$register_university_city=post_data('register_university_city');			

			$register_university_type=post_data('register_university_type');
			$register_university_pincode=post_data('register_university_pincode');
			$register_university_address=post_data('register_university_address');
			$register_university_contact_name=post_data('register_university_contact_name');
			$register_university_contact_email=post_data('register_university_contact_email');
			$register_university_contact_phone_no=post_data('register_university_contact_phone_no');
			$register_university_username=post_data('register_university_username');
			$register_university_password=post_data('register_university_password');

			$register_university_type=post_data('register_university_type');

			$agree_to_tc=post_data('agree_to_tc');

			$this->form_validation->set_rules('register_university_name', 'name', 'required',array('required' => 'Enter your %s.'));
			$this->form_validation->set_rules('register_university_email', 'valid email address', 'trim|required|valid_email',array('required' => 'Enter your %s.'));
			$this->form_validation->set_rules('register_university_phone_no', 'valid phone no.', 'trim|required|numeric|min_length[10]|max_length[10]',array('required' => 'Enter your %s.'));
			$this->form_validation->set_rules('register_university_country', 'country you live in', 'trim|required',array('required' => 'Select %s.'));
			$this->form_validation->set_rules('register_university_state', 'state you live in', 'trim|required',array('required' => 'Select %s.'));
			$this->form_validation->set_rules('register_university_city', 'city you live in', 'trim|required',array('required' => 'Select %s.'));

			$this->form_validation->set_rules('register_university_username', 'username', 'trim|required|min_length[8]|max_length[32]',array('required' => 'Choose an %s for your account.'));
			$this->form_validation->set_rules('register_university_password', 'password', 'trim|required|min_length[8]|max_length[16]',array('required' => 'Enter your %s of choice.'));

			$this->form_validation->set_rules('register_university_contact_name', 'name', 'required',array('required' => 'Enter your %s.'));
			$this->form_validation->set_rules('register_university_contact_email', 'valid email address', 'trim|required|valid_email',array('required' => 'Enter your %s.'));
			$this->form_validation->set_rules('register_university_contact_phone_no', 'valid phone no.', 'trim|required|numeric|min_length[10]|max_length[10]',array('required' => 'Enter your %s.'));

			if ($this->form_validation->run() == TRUE){
				if($check_type=='username'){
					$found=$this->um->get_user_duplicate(array('user_name'=>$register_university_username));
					if($found[0]->counted>0){
						$duplicate=true;
					}else{
						$duplicate=false;
					}
				}else if($check_type=='phone'){
					$found=$this->im->get_university_profile_duplicate(array('university_phone_no'=>$register_university_phone_no));
					if($found[0]->counted>0){
						$duplicate=true;
					}else{
						$duplicate=false;
					}
				}else if($check_type=='email'){
					$found=$this->im->get_university_profile_duplicate(array('university_email'=>$register_university_email));
					if($found[0]->counted>0){
						$duplicate=true;
					}else{
						$duplicate=false;
					}
				}

				if($duplicate==false){

					if(is_string($register_university_country) && is_string($register_university_state) && is_string($register_university_city)){

						if($agree_to_tc=='1'){
							$country_exp=char_separated_to_array($register_university_country,'#');
							$country_id=decode_data($country_exp[0]);
							$state_id=decode_data($register_university_state);
							$city_id=decode_data($register_university_city);
							$university_type=decode_data($register_university_type);

							$otp=gen_otp_code();
							$mail_otp=gen_otp_code();

							$university_short_name=create_initiala($register_university_name);

							$university_data=array(
								'university_country_id'=>$country_id,
								'university_state_id'=>$state_id,
								'university_city_id'=>$city_id,
								'university_user_id'=>'0',
								'university_name'=>$register_university_name,
								'university_short_name'=>$university_short_name,
								'university_estd_year'=>NULL,
								'university_address'=>$register_university_address,
								'university_zipcode'=>$register_university_pincode,
								'university_email'=>$register_university_email,
								'university_phone_no'=>$register_university_phone_no,
								'university_type'=>$university_type,
								'university_status'=>'1',
								'university_affiliation_type'=>null,
								'university_grade_ids'=>null,
								'university_facilities'=>null,
								'is_verified_by_admin'=>'2',
								'university_is_top_ranked'=>'2',
								'university_is_top_visible_home'=>'2',
								'university_is_top'=>'2',
								'is_agreed_to_tc'=>'1',
								'university_contact_person'=>$register_university_contact_name,
								'university_contact_person_email'=>$register_university_contact_email,
								'university_contact_person_phone'=>$register_university_contact_phone_no
							);

							$user_profile_pk_id=$this->im->add_universities_data($university_data);

							if($user_profile_pk_id>0){
								$password	=	password_hash($register_university_password, PASSWORD_BCRYPT, array('cost'=>12));

								$country_data=$this->com->get_country(array('country_id'=>$country_id));
								$state_data=$this->com->get_state(array('state_id'=>$state_id));
								$city_data=$this->com->get_city(array('city_id'=>$city_id));

								$university_user_data=array(
									'user_role'=>'3',
									'user_profile_pk_id'=>$user_profile_pk_id,
									'user_name'=>$register_university_username,
