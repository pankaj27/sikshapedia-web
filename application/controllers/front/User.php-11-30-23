	public function indexSignin(){

		$segment=$this->uri->segment(1,0);

		if($segment=='signin'){
			$view='account/vw_account_signin';

			$this->theme->title($this->data['page_title'])->load($view, $this->data);
		}else{
			redirect(base_url());
		}
	}

	public function indexResetCredentials(){
		$segment=$this->uri->segment(1,0);

		if($segment=='accountreset'){
			if(session_userdata('isUserLoggedin')==TRUE && session_userdata('user_id')){
				redirect(base_url('account'));
			}else{
				$view='account/vw_account_reset';

				$this->data['page_title']='Reset Account';

				$this->theme->title($this->data['page_title'])->load($view, $this->data);
			}
			
		}else{
			redirect(base_url());
		}
	}

	public function indexEdit($user_id=NULL,$reg_from=NULL){
		if(session_userdata('isUserLoggedin')==TRUE && session_userdata('user_id')){
			if($user_id!=NULL){
				$user_id_decoded=decode_data($user_id);

				$countries=$this->com->get_country(array('country_status'=>'1'),FALSE,'country_serial','ASC');
				//echo $user_id_decoded;die;
				if($user_id_decoded==decode_data(session_userdata('user_id'))){
					if(!empty($this->data['userdata'])){

						$userdata=$this->um->get_user_data(array('user_id'=>$user_id_decoded),null,$this->data['userdata']->user_role);

						//print_obj($userdata);die;

						$this->data['userdata']=$userdata;

						//print_obj($this->data['userdata']);die;

						$this->data['page_title']=$userdata->user_fullname;

						if($userdata->user_country>0){
							$country=$userdata->user_country;
						}else{
							$country=$this->data['default_country_data']->country_id;
						}


						if(!empty($countries)){
				          foreach ($countries as $key => $value) {
				            $this->data['countries'][]=array(
				              'country_id'=>encode_data($value->country_id),
				              'country_name'=>$value->country_name,
				              'selected'=>($value->country_id==$country)?'selected':''
				            );
				          }
				        }

						$states=$this->com->get_states(array('state_country_id'=>$country,'state_status'=>'1'),'state_serial','ASC');

						if(!empty($states)){
							foreach ($states as $key => $value) {
								$_states[]=array(
									'state_id'=>encode_data($value->state_id),
									'state_name'=>$value->state_name,
									'selected'=>($value->state_id==$userdata->user_state)?'selected':''
								);
							}
						}else{
							$_states=array();
						}


						$cities=$this->com->_get_cities(array('city_country_id'=>$country,'city_state_id'=>$userdata->user_state));

						if(!empty($cities)){
							foreach ($cities as $key => $value) {
								$_cities[]=array(
									'city_id'=>encode_data($value->city_id),
									'city_name'=>$value->city_name,
									'selected'=>($value->city_id==$userdata->user_city)?'selected':''
								);
							}
						}else{
							$_cities=array();
						}

						//print_obj($userdata);die;

						$this->data['user_fullname']=strlen($userdata->user_fullname) > 6 ? substr($userdata->user_fullname,0,6)."..." : $userdata->user_fullname;

						$this->data['states']=$_states;

						$this->data['cities']=$_cities;

						//print_obj($this->data['states']);die;


						if(isset($reg_from) && $reg_from!=NULL){
							$this->data['reg_from']=decode_data($reg_from);
							$this->data['scholarship_msg']='You need to verify your Phone No. & Account type must be Student for Scholarship';

						}else{
							$this->data['reg_from']='normal';
						}
						

						if($userdata->user_phone_no_verified=='1'){
							$this->theme->title($this->data['page_title'])->add_partial('partial_account_header',$this->data)->load('account/vw_account_profile_basic_info_settings', $this->data);
						}else{
							$this->theme->title($this->data['page_title'])->add_partial('partial_account_header',$this->data)->add_partial('partial_phone_no_verification_modal',$this->data)->load('account/vw_account_profile_basic_info_settings', $this->data);
						}

						
						
					}else{
						redirect(base_url());
					}
				}else{
					redirect(base_url().'account');
				}
			}else{
				redirect(base_url().'account');
			}
		}else{
			redirect(base_url());
		}
	}

	public function indexVerify(){
		$this->data['page_heading']='verify Account';
		$this->data['page_heading_title']='verify Account';
		$this->data['page_title']='verify Account';

		$_user_id=$this->uri->segment(2);

		$user_id=decode_data($_user_id);

		$user_data=$this->um->get_user_data(array('user_id'=>$user_id));

		if(!empty($user_data)){
			
			$updated=$this->um->update_user_data(array('user_email_verified'=>'1','user_blocked'=>'1'),array('user_id'=>$user_id));

			if($updated){
				$session_data=array(
					'isUserLoggedin'=>true,
					'user_id'=>encode_data($user_data->user_id),
					'user_role'=>$user_data->user_role,
					'loggedin_time'=>time()
				);

				session_set_userdata($session_data);
				$this->data['userdata']=$user_data;
				redirect($user_data->user_public_profile_url,'refresh');
			}else{
				$this->data['userdata']=array();
				redirect(base_url(),'refresh');
			}

			$this->theme->title($this->data['page_title'])->load('account/vw_account_verification', $this->data);
		}else{
			show_404();
		}
	}

