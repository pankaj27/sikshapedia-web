	//College Page

	//student Page
	public function indexStudentPage(){
		if(session_userdata('isUserLoggedin')){

			$segment_1=$this->uri->segment(1,0);//account
			$segment_2=$this->uri->segment(2,0);//account

			$userdata=$this->data['userdata'];

			$_cities=array();

			//print_obj($userdata);die;

			//'city_country_id'=>$userdata->user_country,

			$cities=$this->com->get_city(array('city_state_id'=>$userdata->user_state),FALSE);

			//print_obj($cities);die;

			if($userdata->user_role=='8'){

				$this->data['page_title']=$userdata->user_fullname;

				$show_profile_widget=TRUE;
				$show_applied_colleges_widget=FALSE;
				$show_reviews_widget=FALSE;


				$profile_menu_active=TRUE;
				$colege_application_menu_active=FALSE;
				$review_menu_active=FALSE;

				if(!empty($cities)){
					foreach ($cities as $key => $value) {
						$_cities[]=array(
							'city_id'=>encode_data($value->city_id),
							'city_name'=>$value->city_name,
							'selected'=>($value->city_id==$userdata->user_city)?'selected':''
						);
					}
				}

				//print_obj($_cities);die;


				if($segment_2!='0'){

					if($segment_2=='applied-colleges'){
						$show_profile_widget=FALSE;
						$show_applied_colleges_widget=TRUE;
						$show_reviews_widget=FALSE;
						$profile_menu_active=FALSE;
						$colege_application_menu_active=TRUE;
						$review_menu_active=FALSE;
					}else if($segment_2=='my-reviews'){
						$show_profile_widget=FALSE;
						$show_applied_colleges_widget=FALSE;
						$show_reviews_widget=TRUE;

						$profile_menu_active=FALSE;
						$colege_application_menu_active=FALSE;
						$review_menu_active=TRUE;
					}

					
				}

				$this->data['show_profile_widget']=$show_profile_widget;
				$this->data['show_applied_colleges_widget']=$show_applied_colleges_widget;
				$this->data['show_reviews_widget']=$show_reviews_widget;

				$this->data['profile_menu_active']=$profile_menu_active;
				$this->data['colege_application_menu_active']=$colege_application_menu_active;
				$this->data['review_menu_active']=$review_menu_active;

				$this->data['cities']=$_cities;

				//print_obj($this->data['cities']);die;

				$view_page='account/student/vw_profile_student_page';
				$this->theme->title($this->data['page_title'])->load($view_page, $this->data);
			}else{
				redirect(base_url());
			}

				
		}else{
			redirect(base_url());
		}
	}

