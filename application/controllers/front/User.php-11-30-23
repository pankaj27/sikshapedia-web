	public function indexOld(){
		if(session_userdata('isUserLoggedin')==TRUE && session_userdata('user_id')){

			if(!empty($this->data['userdata'])){
				$userdata=$this->data['userdata'];


				//print_obj($userdata);die;

				$countries=$this->com->get_country(array('country_status'=>'1'),FALSE,'country_serial','ASC');
				//print_obj($userdata);die;			

				$this->data['page_title']=(!isset($userdata->user_meta_title))?$userdata->user_fullname:$userdata->user_meta_title;

				if($userdata->user_role=='0'){
					//echo 'hi';
					$redirect=base_url().'account/'.encode_data($userdata->user_id);
					//echo $redirect;die;
					redirect($redirect);
				}else{
					if(!empty($countries)){
			          foreach ($countries as $key => $value) {
			            $this->data['countries'][]=array(
			              'country_id'=>encode_data($value->country_id),
			              'country_name'=>$value->country_name,
			              'selected'=>($value->country_id==$userdata->user_country)?'selected':''
			            );
			          }
			        }

					$states=$this->com->get_states(array('state_country_id'=>$userdata->user_country,'state_status'=>'1'),'state_serial','ASC');

					if(!empty($states)){
						foreach ($states as $key => $value) {
							$_states[]=array(
								'state_id'=>encode_data($value->state_id),
								'state_name'=>$value->state_name,
								'selected'=>($value->state_id==$userdata->user_state)?'selected':''
							);
						}
					}else{
						$_states=array();
					}

					$this->data['states']=$_states;


					$cities=$this->com->get_city(array('city_country_id'=>$userdata->user_country,'city_state_id'=>$userdata->user_state),FALSE,'city_serial','ASC');

					if(!empty($cities)){
						foreach ($cities as $key => $value) {
							$_cities[]=array(
								'city_id'=>encode_data($value->city_id),
								'city_name'=>$value->city_name,
								'selected'=>($value->city_id==$userdata->user_city)?'selected':''
							);
						}
					}else{
						$_cities=array();
					}

					$this->data['cities']=$_cities;

					if($userdata->user_role=='8'){

						$qualifications=$this->im->get_qualifications(array('qualification_status'=>'1'),FALSE);

						foreach ($qualifications as $key => $value) {
							$_qualifications[]=array(
								'qualification_id'=>encode_data($value->qualification_id),
								'qualification_name'=>$value->qualification_name,
								'selected'=>($userdata->user_last_qualification==$value->qualification_id)?'selected':''
							);
						}

						$this->data['qualifications']=$_qualifications;


						$grades=$this->sm->get_grades(array('grading_status'=>'1'),FALSE);

						foreach ($grades as $key => $value) {
							$_grades[]=array(
								'grading_id'=>encode_data($value->grading_id),
								'grading_name'=>$value->grading_name,
								'selected'=>''
							);
						}

						$this->data['grades']=$_grades;

						$view='account/students/vw_account_profile_basic_info_settings';
					}else{
						$view='account/vw_account_profile_basic_info_settings';
					}

					$this->theme->title($this->data['page_title'])->add_partial('partial_account_header',$this->data)->load($view, $this->data);
				}

				
			}else{
				redirect(base_url());
			}
			
		}else{
			redirect(base_url());
		}
	}	


	public function index(){
		if(session_userdata('isUserLoggedin')==TRUE && session_userdata('user_id')){

			
			if(!empty($this->data['userdata'])){
				$userdata=$this->data['userdata'];

				$show_user_menu_widget=TRUE;

				if($userdata->user_role=='4'){
