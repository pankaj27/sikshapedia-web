			$register_college_contact_email=post_data('register_college_contact_email');
			$register_college_contact_phone_no=post_data('register_college_contact_phone_no');
			$register_college_username=post_data('register_college_username');
			$register_college_password=post_data('register_college_password');

			$register_college_type=post_data('register_college_type');

			$agree_to_tc=post_data('agree_to_tc');
			

			$this->form_validation->set_rules('register_college_name', 'name', 'required',array('required' => 'Enter your %s.'));
			$this->form_validation->set_rules('register_college_email', 'valid email address', 'trim|required|valid_email',array('required' => 'Enter your %s.'));
			$this->form_validation->set_rules('register_college_phone_no', 'valid phone no.', 'trim|required|numeric|min_length[10]|max_length[10]',array('required' => 'Enter your %s.'));
			$this->form_validation->set_rules('register_college_country', 'country you live in', 'trim|required',array('required' => 'Select %s.'));
			$this->form_validation->set_rules('register_college_state', 'state you live in', 'trim|required',array('required' => 'Select %s.'));
			$this->form_validation->set_rules('register_college_city', 'city you live in', 'trim|required',array('required' => 'Select %s.'));

			$this->form_validation->set_rules('register_college_username', 'username', 'trim|required|min_length[8]|max_length[32]',array('required' => 'Choose an %s for your account.'));
			$this->form_validation->set_rules('register_college_password', 'password', 'trim|required|min_length[8]|max_length[16]',array('required' => 'Enter your %s of choice.'));

			$this->form_validation->set_rules('register_college_contact_name', 'name', 'required',array('required' => 'Enter your %s.'));
			$this->form_validation->set_rules('register_college_contact_email', 'valid email address', 'trim|required|valid_email',array('required' => 'Enter your %s.'));
			$this->form_validation->set_rules('register_college_contact_phone_no', 'valid phone no.', 'trim|required|numeric|min_length[10]|max_length[10]',array('required' => 'Enter your %s.'));


			$this->form_validation->set_rules('register_college_type', 'country you live in', 'trim|required',array('required' => 'Select %s.'));
			$this->form_validation->set_rules('register_college_pincode', 'pincode/zipcode', 'trim|required',array('required' => 'Enter %s.'));
			$this->form_validation->set_rules('register_college_address', 'address', 'trim|required',array('required' => 'Enter %s.'));


			if ($this->form_validation->run() == TRUE){
				if($check_type=='username'){
					$found=$this->um->get_user_duplicate(array('user_name'=>$register_college_username));
					if($found[0]->counted>0){
						$duplicate=true;
					}else{
						$duplicate=false;
					}
				}else if($check_type=='phone'){
					$found=$this->im->get_college_profile_duplicate(array('college_phone_no'=>$register_college_phone_no));
					if($found[0]->counted>0){
						$duplicate=true;
					}else{
						$duplicate=false;
					}
				}else if($check_type=='email'){
					$found=$this->im->get_college_profile_duplicate(array('college_email'=>$register_college_email));
					if($found[0]->counted>0){
						$duplicate=true;
					}else{
						$duplicate=false;
					}
				}

				if($duplicate==false){

					if(is_string($register_college_country) && is_string($register_college_state) && is_string($register_college_city) && is_string($register_college_university) && is_string($register_college_type)){

						if($agree_to_tc=='1'){
							$country_exp=char_separated_to_array($register_college_country,'#');
							$country_id=decode_data($country_exp[0]);
							$state_id=decode_data($register_college_state);
							$city_id=decode_data($register_college_city);
							$university_id=decode_data($register_college_university);
							$college_type=decode_data($register_college_type);

							$otp=gen_otp_code();
							$mail_otp=gen_otp_code();

							$college_short_name=create_initiala($register_college_name);

							$college_data=array(
								'college_country_id'=>$country_id,
								'college_state_id'=>$state_id,
								'college_city_id'=>$city_id,
								'college_user_id'=>'0',
								'college_university_id'=>$university_id,
								'college_name'=>$register_college_name,
								'college_short_name'=>$college_short_name,
								'college_estd_year'=>'0',
								'college_address'=>$register_college_address,
								'college_zipcode'=>$register_college_pincode,
								'college_email'=>$register_college_email,
								'college_phone_no'=>$register_college_phone_no,
								'college_type'=>$college_type,
								'college_status'=>'1',
								'college_affiliation_type'=>null,
								'college_grade_ids'=>null,
								'college_facilities'=>null,
								'is_verified_by_admin'=>'2',
								'college_is_top_ranked'=>'2',
								'college_is_top_visible_home'=>'2',
								'college_is_top'=>'2',
								'is_agreed_to_tc'=>'1',
								'college_contact_person'=>$register_college_contact_name,
								'college_contact_person_email'=>$register_college_contact_email,
								'college_contact_person_phone'=>$register_college_contact_phone_no
							);

							$user_profile_pk_id=$this->im->add_college_data($college_data);

							if($user_profile_pk_id>0){
								$password	=	password_hash($register_college_password, PASSWORD_BCRYPT, array('cost'=>12));

								$country_data=$this->com->get_country(array('country_id'=>$country_id));
								$state_data=$this->com->get_state(array('state_id'=>$state_id));
								$city_data=$this->com->get_city(array('city_id'=>$city_id));

