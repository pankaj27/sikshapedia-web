									$slug_url=base_url().strtolower($country_data->country_iso_code_2).'/'.$slug_value;
									$folder_name=$slug_value;

									$slug_found=$this->sm->get_slug(array('slug_type_id'=>$user_pk_id,'slug_type'=>'7'));

									if(empty($slug_found)){
										$inserted=$this->sm->store_slug(array('slug_value'=>$slug_value,'slug_type_id'=>$user_pk_id,'slug_type'=>'6'));
										if($inserted){
											$this->im->update_universities_data(array('access_url'=>$slug_url,'access_url_slug'=>$slug_value),array('university_user_id'=>$user_pk_id));
										}
									}



									$sms_data=array(
										'flow_id'=>"61246d38163f8d707f23807f",
										'sender'=>"NCRIPT",
										'mobiles'=>$country_data->country_phone_code.$register_university_contact_phone_no,
										'user_name'=>$university_short_name,
										'otp_code'=>$otp,
										'web_link'=>'signin'
									);

									$sms_param['url']='https://api.msg91.com/api/v5/flow/';
									$sms_param['headers']=array("authkey: 197850AFrGnNLUa5a816402","content-type: application/JSON");
									$sms_param['data']=$sms_data;


									//print_obj($sms_param);
									

									$v_link=base_url().'verify/'.encode_data($inserted);
									$mail_data['protocol']='smtp';
									$mail_data['smtp_host']='host.waytoadmissions.com';
						            $mail_data['password']='InfoWaytoadmin@123%';

									$mail_data['from']=$this->data['system_info_email'];
									$mail_data['from_name']=$this->data['system_name_title'];
									$mail_data['to']=$register_university_contact_email;
									$mail_data['subject']='Account registration Verfication';
									$mail_data['data']=array(
										'user_name'=>$register_university_username,
										'user_full_name'=>ucwords($register_university_name),
										'user_password'=>$register_university_password,
										'system_logo'=>$this->data['system_logo'],
										'system_name'=>$this->data['system_name_title'],
										'system_title'=>$this->data['system_name_title'],
										'send_email_activation_link'=>($country_data->country_iso_code_2!='IN')?'yes':'no',
										'v_link'=>$v_link,
										'otp_code'=>$mail_otp,
										'system_fb_link'=>$this->data['system_facebook_link'],
										'system_twitter_link'=>$this->data['system_twitter_link'],
										'system_google_link'=>$this->data['system_google_link'],
										'system_insta_link'=>$this->data['system_instagram_link'],
										'system_linkedin_link'=>$this->data['system_linkedin_link'],
										'system_email'=>$this->data['system_info_email']
									);

									$mail_data['view']='_email/vw_account_verification_mail';


									$mail_data2['protocol']='smtp';
									$mail_data2['smtp_host']='host.waytoadmissions.com';
						            $mail_data2['password']='InfoWaytoadmin@123%';

									$mail_data2['from']=$this->data['system_info_email'];
									$mail_data2['from_name']=$this->data['system_name_title'];
									$mail_data2['to']=$register_university_contact_email;
									$mail_data2['subject']='Account registration Verfication';
									$mail_data2['data']=array(
										'user_name'=>$register_university_username,
										'user_full_name'=>ucwords($register_university_name),
										'user_password'=>$register_university_password,
										'system_logo'=>$this->data['system_logo'],
										'system_name'=>$this->data['system_name_title'],
										'system_title'=>$this->data['system_name_title'],
										'send_email_activation_link'=>($country_data->country_iso_code_2!='IN')?'yes':'no',
										'v_link'=>$v_link,
										'otp_code'=>$mail_otp,
										'system_fb_link'=>$this->data['system_facebook_link'],
										'system_twitter_link'=>$this->data['system_twitter_link'],
										'system_google_link'=>$this->data['system_google_link'],
										'system_insta_link'=>$this->data['system_instagram_link'],
										'system_linkedin_link'=>$this->data['system_linkedin_link'],
										'system_email'=>$this->data['system_info_email']
									);

									$mail_data2['view']='_email/vw_account_verification_mail';

									send_system_mail($mail_data);
									send_system_mail($mail_data2);
									$p=curl_post($sms_param);

									//print_obj($p);

									$temp_session=array(
										'temp_user'=>encode_data($user_pk_id)
									);
									session_set_userdata($temp_session);

									$return['temp']=encode_data($user_pk_id);
									$return['contact_email']=$register_university_contact_email;
									$return['contact_ph_no']=$register_university_contact_phone_no;
									$return['college_email']=$register_university_email;
									$return['attempts_left']='2';

									$return['success']='<strong>Registration successfull.</strong><br><strong>'.$this->data['system_name_title'].' has sent a 6 digit One-Time Password to '.$register_cuniversity_contact_phone_no.' to verify phone no. and to registered university email address and Contact person email address.You need to verify your contact number and email address inorder to get approved your account and further access to build your mini website.Do not reload this page';
								}
							}else{
								$return['error']='Try again later.';
							}
						}else{
							$return['error']='You have to accept Terms & Conditions.';
						}
							
					}else{
						$return['error']='Data manipulation not allowed.You will be blocked for further access to the site.';
					}
				}else{
					$return['error']='Email,Phone no,Username must be unique.';
				}

				$return['_token'] = $this->security->get_csrf_hash();
			}else{
				$return['error']='All marked (*) are required field to complete your registration.'.validation_errors();
			}
			

				

			header('Content-Type: application/json');

			echo json_encode($return);

		}else{
			redirect(base_url());
		}
	}

	//University Page


	//Student page

	public function indexStudentRegisterPage(){
		if(!session_userdata('isUserLoggedin') && !session_userdata('user_id')){
			$segment_1=$this->uri->segment(1,0);//signup
			$segment_2=$this->uri->segment(2,0);//"colleges"

			//print_obj($this->data);die;

			$page_title='';

			if((is_string($segment_1) && ($segment_1!='0' && $segment_1=='signup')) && (is_string($segment_2) && ($segment_2!='0' && $segment_2=='student'))){

				$courses=$this->strm->get_course(array('course_is_top'=>'1'),FALSE);

				if(!empty($courses)){
					foreach ($courses as $key => $value) {
						$_courses[]=array(
							'course_id'=>encode_data($value->course_id),
							'course_name'=>ucwords($value->course_short_name).'-'.ucwords($value->course_name),
						);
					}
				}else{
					$_courses=array();
				}

				$this->data['courses']=$_courses;

				$page_title=$this->data['page_title'];
				$view_page='account/student/vw_register_student_page';

				$this->theme->title($page_title)->load($view_page, $this->data);

			}else{
				redirect(base_url());
			}
		}else{
			redirect(base_url().'account/settings');
		}			
	}


	


	public function onRegisterStudent(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){

			$register_student_phone_no=post_data('register_student_phone_no');
			$name=post_data('register_student_name');

			$register_student_country=post_data('register_student_country');
			$register_student_course=post_data('register_student_course');

			$agree_to_tc=post_data('agree_to_tc');

			$ucode=ge_rand_code();

			$this->form_validation->set_rules('register_student_name', 'name', 'required',array('required' => 'Enter your %s.'));
			$this->form_validation->set_rules('register_student_phone_no', 'valid phone no.', 'trim|required|numeric|min_length[10]|max_length[10]',array('required' => 'Enter your %s.'));

			if ($this->form_validation->run() == TRUE){

				$profile_dup=$this->um->_get_user_profile_duplicate(array('user_phone_no'=>$register_student_phone_no));
				$user_dup=$this->um->_get_user_duplicate(array('user_name'=>$register_student_phone_no));

				//print_obj($user_dup);die;

				if($profile_dup[0]->counted>0 || $user_dup[0]->counted>0){
					$duplicate=true;
				}else{
					$duplicate=false;
				}

				if($duplicate==false){

					$phone_length=strlen((string)$register_student_phone_no);

					if(is_numeric($register_student_phone_no)){

						if($agree_to_tc=='1'){
							$country_id=decode_data($register_student_country);
							$country_data=$this->com->get_country(array('country_id'=>$country_id));
							
							$otp=gen_otp_code(4);

							if(!empty($register_student_course) && is_string($register_student_course)){
								$course_id=decode_data($register_student_course);
							}else{
								$course_id='0';
							}

							$phone_no=$country_data->country_phone_code.''.$register_student_phone_no;

							$r=sendSMS($phone_no,$otp);

							if(isset($r['success'])){
								$res=json_decode($r['success']);

								if($res->type=='success'){
									$otp_sent='1';
								}else{
									$otp_sent='2';
								}
							}else{
								$otp_sent='2';
							}

							//print_obj($otp_sent);die;

							$student_data=array(
								'user_country'=>$country_id,
								'user_state'=>'0',
								'user_city'=>'0',
								'user_m_id'=>'0',
								'user_fullname'=>$name,
								'user_email'=>null,
								'user_phone_no'=>$register_student_phone_no,
								'user_course_interested'=>$course_id,
								'user_code'=>$ucode,
								'is_agreed_to_tc'=>$agree_to_tc
							);

							$user_profile_pk_id=$this->um->add_user_profile_data($student_data);

							if($user_profile_pk_id>0){
								$password	=	password_hash('Password@123', PASSWORD_BCRYPT, array('cost'=>12));

								$ustudent_user_data=array(
									'user_role'=>'8',
									'user_profile_pk_id'=>$user_profile_pk_id,
									'user_name'=>$register_student_phone_no,
									'user_password'=>$password,
									'user_password_visible'=>encode_data($register_student_password),
									'user_blocked'=>'1',
									'user_approved'=>'2',
									'user_email_verified'=>'2',
									'user_phone_no_verified'=>'2',
									'user_otp'=>$otp,
									'user_mail_otp'=>$otp,
									'user_top_sent_date'=>date('Y-m-d H:i:s'),
									'created_by'=>'0',
									'created_by_type'=>'3',
									'user_created_through'=>'1',
									'user_sent_from'=>'normal',
									'user_otp_sent_count'=>$otp_sent,
									'user_registration_type'=>'self',					
									'user_currency'=>($country_data->country_currency!='')?$country_data->country_currency:'4'
								);

								$user_pk_id=$this->um->add_user_data($ustudent_user_data,FALSE,FALSE);

								if($user_pk_id){
									$this->um->update_user_profile_data(array('user_m_id'=>$user_pk_id),array('user_profile_id'=>$user_profile_pk_id));

									$temp_session=array(
										'temp_user'=>encode_data($user_pk_id)
									);

									session_set_userdata($temp_session);

									$return['temp']=encode_data($user_pk_id);
									$return['contact_ph_no']=$register_student_phone_no;
									$return['attempts_left']='2';

									$return['success']='<strong>Registration successfull.</strong><br><strong>'.$this->data['system_name_title'].' has sent a 4 digit One-Time Password to '.$register_student_phone_no.' to verify phone no.';
								}else{
									$return['error']='Try again later.';
								}
							}else{
								$return['error']='Try again later.';
							}

						}else{
							$return['error']='You have to accept Terms & Conditions.';
						}	

					}else{
						$return['error']='Data manipulation not allowed.You will be blocked for further access to the site.';
					}
				}else{
					$return['error']='Phone no already in use.';
				}

			}else{
				$return['error']='All marked (*) are required field to complete your registration.'.validation_errors();
			}

			$return['_token'] = $this->security->get_csrf_hash();

			header('Content-Type: application/json');

			echo json_encode($return);
		}else{
			redirect(base_url());
		}
	}




	//Student Page

	public function onResetCredentials(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){
			//$register_account_type=post_data('register_account_type');
			$register_phone_no=post_data('register_phone_no');
			//$register_email=post_data('register_email');

			$send_type=post_data('send_type');

			//if(!empty($register_account_type) && is_string($register_account_type)){

				$account_type=decode_data($register_account_type);
	
				$this->form_validation->set_rules('register_phone_no', 'valid phone no.', 'trim|required|numeric|min_length[10]|max_length[10]',array('required' => 'Enter your %s.'));

				if ($this->form_validation->run() == TRUE){

					if($account_type=='3'){
						$found=$this->im->get_university_profile_data(array('university_contact_person_phone'=>$register_phone_no));
						if(!empty($found)){
							$user_id=$found->university_user_id;
							$country_id=$found->university_country_id;
							$user_name=$found->university_name;
							$user_phone=$found->university_contact_person_phone;
							$contact_email=$found->university_contact_person_email;
						}
					}else if($account_type=='4'){
						$found=$this->im->get_college_profile_data(array('college_contact_person_phone'=>$register_phone_no));
						if(!empty($found)){
							$user_id=$found->college_user_id;
							$user_name=$found->college_name;
							$country_id=$found->college_country_id;
							$user_phone=$found->college_contact_person_phone;
							$contact_email=$found->college_contact_person_email;
						}
					}else if($account_type=='8'){
						$found=$this->um->get_user_profile_data(array('user_phone_no'=>$register_phone_no));
						if(!empty($found)){
							$user_id=$found->user_m_id;
							$user_name=$found->user_fullname;
							$country_id=$found->user_country;
							$user_phone=$found->user_phone_no;
							$contact_email=$found->user_email;
						}
					}

					if(isset($contact_email) && !empty($contact_email)){

						$otp=gen_otp_code();
						$user_data=$this->um->get_user(array('user_id'=>$user_id));						
						$country_data=$this->com->get_country(array('country_id'=>$country_id));

						if($send_type=='resetotp'){
							$sms_data=array(
								'flow_id'=>"61246e55c8ef5d2f7c43fedd",
								'sender'=>"NCRIPT",
								'mobiles'=>$country_data->country_phone_code.$user_phone,
								'user_name'=>ucwords($user_name),
								'otp_code'=>$otp,
								'web_link'=>base_url().'signin'
							);

							$sms_param['url']='https://api.msg91.com/api/v5/flow/';
							$sms_param['headers']=array("authkey: 197850AFrGnNLUa5a816402","content-type: application/JSON");
							$sms_param['data']=$sms_data;

							//print_obj($sms_param);

							$sent=curl_post($sms_param);

							if($sent['success']){
								$return['success']='A 6 digit One-Time-Password has been sent to your registered mobile no.';
							}else{
								$return['error']='There was an error occurred.Try after sometime.';
							}
						}else if($send_type=='getreset'){
							$user_password=decode_data($user_data->user_password_visible);
							$sms_data=array(
								'flow_id'=>"61246deafe718968e82adab3",
								'sender'=>"NCRIPT",
								'mobiles'=>$country_data->country_phone_code.$user_phone,
								'user_email'=>ucwords($user_name),
								'user_password'=>$user_password,
								'web_link'=>base_url().'signin'
							);

							$sms_param['url']='https://api.msg91.com/api/v5/flow/';
							$sms_param['headers']=array("authkey: 197850AFrGnNLUa5a816402","content-type: application/JSON");
							$sms_param['data']=$sms_data;

							$sent=curl_post($sms_param);

							if($sent['success']){
								$return['success']='Your password has ben sent to your registered phone no & email address';
							}else{
								$return['error']='There was an error occurred.Try after sometime.';
							}
						}

							
					}else{
						$return['error']=$register_phone_no.' is not registered.Check again.';
					}

				}else{
					$return['error']='All marked (*) are required field to complete your registration.'.validation_errors();
				}

			// }else{
			// 	$return['error']='data manupulation is not allowed.Your account may blocked.';
			// }

			$return['_token'] = $this->security->get_csrf_hash();

			header('Content-Type: application/json');

			echo json_encode($return);
		}
	}

	public function onGetResetData(){
