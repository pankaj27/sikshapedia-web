	//Sign In User with OTP
	public function onSigninwithOTP(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){

			$action_type=post_data('action_type');

			$country_id='99';

			if($action_type=='send_login_otp'){
				$otp_send_mobile_no=post_data('otp_send_mobile_no');
				if(!empty($otp_send_mobile_no)){
					$otp= gen_otp_code(4);
					$token=token();
					$date=date('Y-m-d');

					$profile_data=$this->um->get_user_data(array('user_phone_no'=>$otp_send_mobile_no),null,'8');

					//print_obj($profile_data);die;

					$country_data=$this->com->get_country(array('country_id'=>$country_id));

					if(!empty($profile_data)){
						
						$profile_user_data=$this->um->get_user(array('user_id'=>$profile_data->user_id));

						if(!empty($profile_user_data)){

							$user_otp_sent_count=$profile_user_data->user_otp_sent_count+1;

							$updated=$this->um->update_user_data(array('user_otp'=>$otp,'user_mail_otp'=>$otp,'user_top_sent_date'=>date('Y-m-d H:i:s'),'user_login_token'=>$token,'user_otp_sent_count'=>$user_otp_sent_count),array('user_id'=>$profile_data->user_id));

							if($updated){
								$phone_no=$country_data->country_phone_code.$otp_send_mobile_no;

								$response=sendSMS($phone_no,$otp);

								$return['success']='A 4-digit OTP has been sent to '.$otp_send_mobile_no;
								$return['otp_token']=$token;
							}else{
								$return['error']='Try again later';
							}

						}else{
							$return['error']='Data not found 0';
						}
					}else{
						$return['error']='<div class="alert alert-danger">Mobile number not registered.</div>';
					}

				}else{
					$return['error']='<div class="alert alert-danger">Enter mobile no.</div>';
				}
			}else if($action_type=='verify_login_otp'){
				$otp_no=post_data('otp_no');
				$otp_token=post_data('otp_token');
				if(!empty($otp_no) && is_numeric($otp_no) && !empty($otp_token)){

					$user_data=$this->um->get_user(array('user_otp'=>$otp_no,'user_login_token'=>$otp_token));

					if($user_data){
						$token=token();
						$this->um->update_user_data(array('user_login_token'=>$token,'user_otp_sent_count'=>'0','user_otp'=>null),array('user_id'=>$user_data->user_id));
						$session_data=array(
							'isUserLoggedin'=>true,
							'user_id'=>encode_data($user_data->user_id),
							'user_role'=>encode_data($user_data->user_role),
							'user_token'=>encode_data($token),
							'loggedin_time'=>time()
						);

						session_set_userdata($session_data);

						if(isset($_SESSION['review_link'])){
							$redirect=$_SESSION['review_link'];
						}
						else{
							$redirect=base_url('account');
						}

						$return['redirect'] = $redirect;
					}else{
						$return['error']='<div class="alert alert-danger">Invalid OTP</div>';
					}

				}else{
					$return['error']='<div class="alert alert-danger">Invalid OTP</div>';
				}
			}

				

			header('Content-Type: application/json');

			echo json_encode($return);

		}else{
			redirect(base_url());
		}
	}


	//Regisster All types of User
	public function onRegisterUser(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){

			// $ctext=post_data('ctext');

			// //print_obj($ctext);

			// $security_token = $this->data['security_token'];
			// //print_obj($security_token);

			// $decrypted = CryptoJsAes::decrypt($ctext, $security_token);

			// //print_obj($decrypted);die;

			// $user_name=clean_data($decrypted['registration_name']);
			// $user_email=clean_data($decrypted['registration_email']);
			// $user_phone=clean_data($decrypted['registration_phone_no']);
			// $user_country=decode_data($decrypted['register_country']);
			// $user_state=decode_data($decrypted['register_state']);
			// $user_city=decode_data($decrypted['register_city']);
			// $user_password=clean_data($decrypted['registration_password']);

			// $user_reg_from=clean_data($decrypted['registration_from']);

			// $user_country_exp=explode('#', $user_country);
			// $country=$user_country_exp[0];

			$user_name=post_data('registration_name');
			$user_email=post_data('registration_email');
			$user_phone=post_data('registration_phone_no');
			$user_country=post_data('register_country');
			$user_state=post_data('register_state');
			$user_city=post_data('register_city');
			$user_password=post_data('registration_password');

			$user_country_exp=explode('#', $user_country);
			$ucountry=$user_country_exp[0];
			$country=decode_data($ucountry);

			$country_data=$this->com->get_country(array('country_id'=>$country));

			$user_reg_from=post_data('registration_from');

			//echo decode_data($user_state);die;

			//echo $user_country;die;

			//$get_user_duplicate=$this->um->get_user_duplicate(array('user_name'=>$user_email),null,FALSE);

			$get_temp_user_duplicate=$this->um->get_user_temp_duplicate(NULL,array('temp_user_email'=>$user_email,'temp_user_phone'=>$user_phone),NULL,FALSE);

			$otp= gen_otp_code();

			//print_obj($get_temp_user_duplicate);die;

			$sms_data=array(
				'flow_id'=>"61246d38163f8d707f23807f",
				'sender'=>"NCRIPT",
				'mobiles'=>$country_data->country_phone_code.$user_phone,
				'user_name'=>ucwords($user_name),
				'otp_code'=>$otp,
				'web_link'=>base_url()
			);

			$sms_param['url']='https://api.msg91.com/api/v5/flow/';
			$sms_param['headers']=array("authkey: 197850AFrGnNLUa5a816402","content-type: application/JSON");
			$sms_param['data']=$sms_data;

			$v_link=base_url().'verify/'.encode_data($inserted);
			$mail_data['protocol']='smtp';
			$mail_data['smtp_host']='host.waytoadmissions.com';
            $mail_data['password']='InfoWaytoadmin@123%';

			$mail_data['from']=$this->data['system_info_email'];
			$mail_data['from_name']=$this->data['system_name'];
			$mail_data['to']=$user_email;
			$mail_data['subject']='Account registration Verfication';
			$mail_data['data']=array(
				'user_name'=>$user_email,
				'user_full_name'=>ucwords($user_name),
				'user_password'=>$user_password,
				'system_logo'=>$this->data['system_logo'],
				'system_name'=>$this->data['system_name'],
				'system_title'=>$this->data['system_title'],
				'send_email_activation_link'=>($country_data->country_iso_code_2!='IN')?'yes':'no',
				'v_link'=>$v_link,
				'otp_code'=>$otp,
				'system_fb_link'=>$this->data['system_facebook_link'],
				'system_twitter_link'=>$this->data['system_twitter_link'],
				'system_google_link'=>$this->data['system_google_link'],
				'system_insta_link'=>$this->data['system_instagram_link'],
				'system_linkedin_link'=>$this->data['system_linkedin_link'],
				'system_email'=>$this->data['system_info_email']
			);

			$mail_data['view']='_email/vw_account_verification_mail';

			if($get_temp_user_duplicate[0]->counted=='0'){

				$password	=	password_hash($user_password, PASSWORD_BCRYPT, array('cost'=>12));			

				$data=array(
					'user_name'=>$user_email,
					'user_password'=>$password,
					'user_password_visible'=>encode_data($user_password),
					'user_blocked'=>'0',
					'user_email_verified'=>'0',
					'user_otp'=>$otp,
					'user_phone_no_verified'=>'2',
					'user_sent_from'=>$user_reg_from
				);

				$inserted=$this->um->add_user_data($data);

				if($inserted){
					$state=decode_data($user_state);
					$city=decode_data($user_city);
					$temp_data=array(
						'temp_user_pk_id'=>$inserted,
						'temp_user_name'=>ucwords($user_name),
						'temp_user_email'=>$user_email,
						'temp_user_phone'=>$user_phone,
						'temp_user_password'=>$password,
						'temp_user_country'=>$country,
						'temp_user_state'=>$state,
						'temp_user_city'=>$city,
						'temp_user_system_ip'=>$this->input->ip_address()
					);
					$temp_data_added=$this->um->add_user_temp_data($temp_data);

					if($temp_data_added){
						send_system_mail($mail_data,'html');
						curl_post($sms_param);						
					}

					$return['success']='You have registered successfully.An verification mail & OTP sent to your mail address and phone no.';
					$return['success_msg_otp']='OTP (6 digit otp has been sent to '.$user_phone.')';
					$return['otp_user']=encode_data($inserted);
						
				}else{
					$return['error']='Registration failed for this moment.Please try again later.';
				}

			}else{

				$get_userdata=$this->um->get_user_data(array('temp_user_email'=>$user_email),null,'0');

				//print_obj($this->data['system_info_email']);die;

				if(!empty($get_userdata) && ($get_userdata->user_phone_no==$user_phone)){

					$data=array(
						'user_otp'=>$otp,
						'user_sent_from'=>$user_reg_from
					);

					$inserted=$this->um->update_user_data($data,array('user_id'=>$get_userdata->user_id));

					if($inserted){

						send_system_mail($mail_data,'html',FALSE);

						curl_post($sms_param);
	                    $return['success']='You have registered successfully.An verification mail & OTP sent to your mail address and phone no.';
						$return['success_msg_otp']='OTP (6 digit otp has been sent to '.$user_phone.')';
						$return['otp_user']=encode_data($get_userdata->user_id);	
					}else{
						$return['error']='There was an system error.';
					}

				}else{
					$return['error']='Email/Phone No. is already taken.';
				}
				
			}

			header('Content-Type: application/json');

			echo json_encode($return);		
		}else{
			redirect(base_url());
		}		
	}

	public function onVerifyUser(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){
			// $ctext=post_data('ctext');

			// $security_token = $this->data['security_token'];
			// //print_obj($security_token);die;

			// $decrypted = CryptoJsAes::decrypt($ctext, $security_token);


			// $_user_id=clean_data($decrypted['registration_user']);

			// $otp=clean_data($decrypted['registration_otp']);

			$_user_id=post_data('registration_user');

			$otp=post_data('registration_otp');

			$user_id=decode_data($_user_id);

			$user_found=$this->um->get_user(array('user_id'=>$user_id));

			//print_obj($user_found);die;

			if(!empty($user_found)){
				if($user_found->user_otp==$otp){
					$data_to_update=array(
						'user_phone_no_verified'=>'1',
						'user_approved'=>'1',
						'user_blocked'=>'1'
					);

					$updated=$this->um->update_user_data($data_to_update,array('user_id'=>$user_id));

					if($updated){

						if($user_found->user_sent_from=='normal'){

							// $user_temp_profile=$this->db->get_user_temp(array('temp_user_pk_id'=>$user_id));

							// if(!empty($user_profile)){
							// 	$user_profile_data=array(
									
							// 	);
							// }else{

							// }


							$session_data=array(
								'isUserLoggedin'=>true,
								'user_id'=>encode_data($user_found->user_id),
								'user_role'=>encode_data($user_found->user_role),
								'loggedin_time'=>time()
							);

							session_set_userdata($session_data);
							$this->data['userdata']=$user_found;
							$redirect=base_url().'account/'.encode_data($user_id);
							$return['success']='Phone no verified successfully';
							$return['redirect']=$redirect;
						}else if($user_found->user_sent_from=='scholarship'){

							$temp_user_data=$this->um->get_user_temp(array('temp_user_pk_id'=>$user_id));

							$data_profile=array(
								'user_m_id'=>$user_id,
								'user_fullname'=>$temp_user_data->temp_user_name,
								'user_email'=>$temp_user_data->temp_user_email,
								'user_phone_no'=>$temp_user_data->temp_user_phone,
								'user_country'=>$temp_user_data->temp_user_country
							);

							$profile_added=$this->um->add_user_profile_data($data_profile);

							if($profile_added){
								$country_data=$this->com->get_country(array('country_id'=>$temp_user_data->temp_user_country));
								$session_data=array(
									'isUserLoggedin'=>true,
									'user_id'=>encode_data($user_found->user_id),
									'user_role'=>encode_data($user_found->user_role),
									'loggedin_time'=>time()
								);

								$country_code=strtolower($country_data->country_iso_code_2);

								session_set_userdata($session_data);
								$this->data['userdata']=$user_found;
								$redirect=base_url().$country_code.'/scholarship';
								$return['success']='Phone no verified successfully';
								$return['redirect']=$redirect;
							}else{
								$return['error']='There was an system error.Please try later.';
							}
						}
							
					}else{
						$return['error']='There was an system error.Please try later.';
					}
				}else{
					$return['error']='OTP is not valid';
				}
			}else{
				$return['error']='Data not found in the system';
			}

			header('Content-Type: application/json');

			echo json_encode($return);


		}else{
			redirect(base_url());
		}
	}


	public function onSendOTP(){
		if(session_userdata('isUserLoggedin')==TRUE && session_userdata('user_id')){
			if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){
				$ph_no=post_data('ph_no');
				$user_id=decode_data(session_userdata('user_id'));

				$user_by_phone=$this->um->get_user_data(array('user_phone_no'=>$ph_no));

				if(empty($user_by_phone)){
					if($ph_no!=''){
						$limit = 6;
						$otp= random_int(10 ** ($limit - 1), (10 ** $limit) - 1);

						$curl = curl_init();

	                      curl_setopt_array($curl, array(
	                      CURLOPT_URL => "https://api.msg91.com/api/v5/otp?authkey=197850AFrGnNLUa5a816402&template_id=5f741be17b17cc67a74ff47c&mobile=$ph_no&invisible=1&otp=$otp",
	                      CURLOPT_RETURNTRANSFER => true,
	                      CURLOPT_ENCODING => "",
	                      CURLOPT_MAXREDIRS => 10,
	                      CURLOPT_TIMEOUT => 30,
	                      CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
	                      CURLOPT_CUSTOMREQUEST => "GET",
	                      CURLOPT_SSL_VERIFYHOST => 0,
	                      CURLOPT_SSL_VERIFYPEER => 0,
	                      CURLOPT_HTTPHEADER => array(
	                        "content-type: application/json"
	                      ),
	                    ));
	                    
	                    $response = curl_exec($curl);
	                    $err = curl_error($curl);
	                    
	                    curl_close($curl);
	                    
	                    if ($err) {
	                        $msg="$err";
		                    $return['error']=$msg;
	                    }else {

	                    	$data_to_update=array(
	                    		'user_top_sent_date'=>date('Y-m-d H:i:s'),
								'user_otp'=>$otp
							);
							$updated=$this->um->update_user_data($data_to_update,array('user_id'=>$user_id));

							if($updated){
								$return['success']='OTP sent to '.$ph_no;
							}else{
								$return['error']='There was a problem for the momment.Try again later.';
							}	
	                    }
					}else{
						$return['error']='Phone no is invalid';
					}
				}else{
					$return['error']='Phone No. already taken';
				}
					

				header('Content-Type: application/json');

				echo json_encode($return);
			}else{
				redirect(base_url());
			}
		}else{
			redirect(base_url());
		}
			
	}

	public function indexVerifyAccount($uid){
		$this->data['page_heading']='verify Account';
		$this->data['page_heading_title']='verify Account';
		$this->data['page_title']='verify Account';

	
		if($uid!=null){
			$user_id=decode_data($uid);			

			if(is_numeric($user_id)){
				$user_found=$this->um->get_user_data(array('user_id'=>$user_id),null,'0');

				//print_obj($user_found);die;

				if(!empty($user_found) && $user_found->user_blocked!='1' && $user_found->user_email_verified!='1'){
					$data=array(
						'user_blocked'=>'1',
						'user_email_verified'=>'1',
						'user_approved'=>'1'
					);

					$updated=$this->um->update_user_data($data,array('user_id'=>$user_id));

					if($updated){
						$session_data=array(
							'isUserLoggedin'=>true,
							'user_id'=>encode_data($user_found->user_id),
							'user_role'=>encode_data($user_found->user_role),
							'loggedin_time'=>time()
						);

						session_set_userdata($session_data);
						$this->data['userdata']=$user_found;
						$redirect=base_url().'account/'.encode_data($user_id);
					}else{
						$redirect=base_url();
					}
				}else if(!empty($user_found) && $user_found->user_blocked=='1' && $user_found->user_email_verified=='1'){
					if($user_found->user_role=='0'){
						$redirect=base_url().'account/'.encode_data($user_id);
					}else{
						$redirect=base_url().'account';
					}
				}
				else{
					$redirect=base_url();
				}
			}else{
				$redirect=base_url();
			}

		}else{
			$redirect=base_url();
		}

		redirect($redirect);
	}

