	public function onRegisterApplicant(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){

			$form_type=post_data('form_type');

			if($form_type=='with_login'){
				$applicant_course=post_data('applicant_course');
				$applicant_institute=post_data('applicant_institute');
				$applicant_institute_type=post_data('applicant_institute_type');

				$inst_id=$applicant_institute;
				$inst_type=$applicant_institute_type;
				$course_id=decode_data($applicant_course);

				$user_data=$this->data['userdata'];

				//print_obj($user_data);die;

				if($course_id!=''){
					$applicant_full_name=$user_data->user_fullname;
					$applicant_email=$user_data->user_email;
					$applicant_ph=$user_data->user_phone_no;
					$city_id=$user_data->user_city;

					$city_data=$this->com->get_city(array('city_id'=>$city_id));

					$country_data=$this->com->get_country(array('country_id'=>$user_data->user_country));

					$applicant_found=$this->um->get_applicant(array('applicant_email'=>$applicant_email,'applicant_ph'=>$applicant_ph,'applicant_course_id'=>$course_id,'application_inst_id'=>$inst_id));

					if(!empty($applicant_found)){
						$data_to_insert=array(
							'applicant_id'=>$user_data->user_id,
							'applicant_country_id'=>$user_data->user_country,
							'applicant_state_id'=>$user_data->user_state,
							'applicant_city_id'=>$city_id,
							'applicant_course_id'=>$course_id,
							'application_inst_id'=>$inst_id,
							'application_inst_type'=>$inst_type,
							'applicant_name'=>$applicant_full_name,
							'applicant_email'=>$applicant_email,
							'applicant_ph'=>$applicant_ph,
							'application_mail_sent'=>'2',
							'applicant_aggreed_tc'=>'1',
							'applicant_ph_verified'=>'yes',
							'application_re_date'=>date('Y-m-d')
						);

						$this->um->update_applicant_data($data_to_insert,array('application_id'=>$applicant_found->application_id));

						$inserted=$applicant_found->application_id;

					}else{
						$data_to_insert=array(
							'applicant_id'=>$user_data->user_id,
							'applicant_country_id'=>$user_data->user_country,
							'applicant_state_id'=>$user_data->user_state,
							'applicant_city_id'=>$city_id,
							'applicant_course_id'=>$course_id,
							'application_inst_id'=>$inst_id,
							'application_inst_type'=>$inst_type,
							'applicant_name'=>$applicant_full_name,
							'applicant_email'=>$applicant_email,
							'applicant_ph'=>$applicant_ph,
							'application_mail_sent'=>'2',
							'applicant_aggreed_tc'=>'1',
							'applicant_ph_verified'=>'yes'
						);

						//print_obj($data_to_insert);die;

						$inserted=$this->um->add_applicant_data($data_to_insert);
					}


					if($inserted){

						$return['_inst']=encode_data($inst_id);
						$return['_applicant']=encode_data($inserted);
						$return['_ph']=$applicant_ph;
						$return['_email']=$applicant_email;
						$return['_course']=encode_data($course_id);
						$return['success']='Thank you for your interest.Our representative will get back to you soon.';
					}else{
						$return['error']='Apllication can not be sent now.Try again later';
					}
				}else{
					$return['error']='Select your course of interest.';
				}

				
			}else if($form_type=='without_login'){
				$applicant_course=$this->input->post('applicant_course');
				$applicant_institute=post_data('applicant_institute');
				$applicant_institute_type=post_data('applicant_institute_type');

				$applicant_full_name=post_data('applicant_full_name');
				$applicant_email=post_data('applicant_email');
				$applicant_ph=post_data('applicant_ph');
				$applicant_city=post_data('applicant_city');
				$applicant_country=post_data('applicant_country');
				$applicant_state=post_data('applicant_state');

				$exp=explode('#', $applicant_country);
				$country=$exp[0];

				//echo $applicant_course.'<br>';

				$inst_id=decode_data($applicant_institute);
				$inst_type=decode_data($applicant_institute_type);
				$course_id=decode_data($applicant_course);
				$city_id=$applicant_city;//decode_data($applicant_city);
				$sata_id=decode_data($applicant_state);
				$country_id=decode_data($country);

				//echo $city_id;die;

				//echo $course_id;die;

				if(!empty($applicant_full_name) && !empty($applicant_email) && valid_email($applicant_email) && !empty($applicant_ph) && ($city_id!='0' || !is_null($city_id))){
					$applicant_found=$this->um->get_applicant(array('applicant_ph'=>$applicant_ph,'applicant_course_id'=>$course_id,'application_inst_id'=>$inst_id));

					//print_obj($applicant_found);die;

					$city_data=$this->com->get_city(array('city_id'=>$city_id));

					$country_data=$this->com->get_country(array('country_id'=>$country_id));

					$otp=gen_otp_code(4);

					if(!empty($applicant_found)){
						$data_to_insert=array(
							'applicant_country_id'=>$country_id,
							'applicant_state_id'=>$city_data->city_state_id,
							'applicant_city_id'=>$city_id,
							'applicant_course_id'=>'0',
							'application_inst_id'=>$inst_id,
							'application_inst_type'=>$inst_type,
							'applicant_name'=>$applicant_full_name,
							'applicant_email'=>$applicant_email,
							'applicant_ph'=>$applicant_ph,
							'application_mail_sent'=>'2',
							'applicant_aggreed_tc'=>'1',
							'applicantion_otp'=>$otp
						);

						$this->um->update_applicant_data($data_to_insert,array('application_id'=>$applicant_found->application_id));

						$inserted=$applicant_found->application_id;

					}else{
						$data_to_insert=array(
							'applicant_country_id'=>$country_id,
							'applicant_state_id'=>$city_data->city_state_id,
							'applicant_city_id'=>$city_id,
							'applicant_course_id'=>$course_id,
							'application_inst_id'=>$inst_id,
							'application_inst_type'=>$inst_type,
							'applicant_name'=>$applicant_full_name,
							'applicant_email'=>$applicant_email,
							'applicant_ph'=>$applicant_ph,
							'application_mail_sent'=>'2',
							'applicant_aggreed_tc'=>'1',
							'application_re_date'=>date('Y-m-d'),
							'applicantion_otp'=>$otp
						);

						$inserted=$this->um->update_applicant_data($data_to_insert,array('applicant_ph'=>$applicant_ph,'applicant_course_id'=>$course_id,'application_inst_id'=>$inst_id));
					}

					if($inserted){
						$user_name=random_username($applicant_full_name);

						$ph=$country_data->country_phone_code.$applicant_ph;

						sendSMS($ph,$otp);

						$return['_inst']=encode_data($inst_id);
						$return['_applicant']=encode_data($inserted);
						$return['_ph']=$applicant_ph;
						$return['_email']=$applicant_email;
						$return['_course']=encode_data($course_id);
						$return['success']='Thank you for your interest.An 4-digit OTP has been sent to your given phone no.Verify the OTP.Our representative will get back to you soon.';
						$return['success']='Thank you for your interest.You will be contacted soon from our end.';
					}else{
						$return['error']='Apllication can not be sent now.Try again later';
					}
				}else{
					$return['error']='All (*) marked fields are required.';
				}
			}			
			
			json_headers($return);		

		}else{
			redirect(base_url());
		}
	}


	public function onVerifyApplicantAccount(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){

			$applicant_php=post_data('applicant_php');
			$phone_otp=post_data('applicant_ph_otp');
			//$_applicant_course=post_data('_applicant_course');

			$college_data=array();


			if(!empty($applicant_php) || !is_null($applicant_php)){

				$application_id=decode_data($applicant_php);

				$applicant_found=$this->um->get_applicant(array('application_id'=>$application_id));

				if(!empty($applicant_found)){

					$this->form_validation->set_rules('applicant_ph_otp', 'OTP', 'trim|required|numeric',array('required' => 'Enter OTP %s.','numeric'=>'Only numeric value allowed.'));

					if ($this->form_validation->run() == TRUE){
						if($applicant_found->applicantion_otp==$phone_otp){
							$data_to_insert=array(
								'applicantion_otp'=>null,
								'applicant_ph_verified'=>'yes'
							);

							$updated=$this->um->update_applicant_data($data_to_insert,array('application_id'=>$applicant_found->application_id));

							if($updated){

								$param['user_course']=$applicant_found->applicant_course_id;
								$post['length']='3';
								$institutes=$this->im->_get_colleges_by_courses($post,$param,FALSE,TRUE);

								// print_obj($institutes);die;

								$user_found=$this->um->_get_user_profile_duplicate(array('user_phone_no'=>$applicant_found->applicant_ph),array('user_email'=>$applicant_found->applicant_email));

								if($user_found[0]->counted==0){
									$ucode=ge_rand_code();
									$student_data=array(
										'user_code'=>$ucode,
										'user_country'=>$applicant_found->applicant_country_id,
										'user_state'=>$applicant_found->applicant_state_id,
										'user_city'=>$applicant_found->applicant_city_id,
										'user_m_id'=>'0',
										'user_fullname'=>$applicant_found->applicant_name,
										'user_email'=>$applicant_found->applicant_email,
										'user_phone_no'=>$applicant_found->applicant_ph,
										'user_course_interested'=>$applicant_found->applicant_course_id,
										'is_agreed_to_tc'=>'1'
									);

									$user_profile_pk_id=$this->um->add_user_profile_data($student_data);

									if($user_profile_pk_id){
										$password	=	password_hash('Password@123', PASSWORD_BCRYPT, array('cost'=>12));

										$country_data=$this->com->get_country(array('country_id'=>$applicant_found->applicant_country_id));

										$ustudent_user_data=array(
											'user_role'=>'8',
											'user_profile_pk_id'=>$user_profile_pk_id,
											'user_name'=>$applicant_found->applicant_ph,
											'user_password'=>$password,
											'user_password_visible'=>encode_data('Password@123'),
											'user_blocked'=>'1',
											'user_approved'=>'2',
											'user_email_verified'=>'1',
											'user_phone_no_verified'=>'1',
											'user_top_sent_date'=>date('Y-m-d H:i:s'),
											'created_by'=>'0',
											'created_by_type'=>'3',
											'user_created_through'=>'1',
											'user_sent_from'=>'normal',
											'user_otp_sent_count'=>'1',						
											'user_currency'=>($country_data->country_currency!='')?$country_data->country_currency:'4'
										);

										$user_pk_id=$this->um->add_user_data($ustudent_user_data,FALSE,FALSE);

										if($user_pk_id){
											$this->um->update_user_profile_data(array('user_m_id'=>$user_pk_id),array('user_profile_id'=>$user_profile_pk_id));

											$this->um->update_applicant_data(array('applicant_id'=>$user_pk_id),array('application_id'=>$applicant_found->application_id));
										}
									}
								}else{
									$udata=$this->um->_get_user_data(array('user_phone_no'=>$applicant_found->applicant_ph));
									$this->um->update_applicant_data(array('applicant_id'=>$udata->user_m_id),array('application_id'=>$applicant_found->application_id));
								}

								if(!empty($institutes)){
									foreach ($institutes as $key => $value) {

										if(!is_null($value->college_user_id) && $applicant_found->application_inst_id!=$value->college_user_id){
											//$college_profile=$this->sm->__get_system_search_data(array('search_data_type_id'=>$value->user_id,'search_data_type'=>'COLLEGE_NAME'));

											//if((!empty($college_profile) || !is_null($college_profile)) && !empty($college_profile->search_data_name)){
												$college_banner=$this->sm->get_user_file(array('user_file_type_id'=>$value->college_user_id,'user_storage_type'=>'user_banner'));
							    				$college_logo=$this->sm->get_user_file(array('user_file_type_id'=>$value->college_user_id,'user_storage_type'=>'user_logo'));

							    				if(!empty($college_logo) && !empty($college_logo->media_disk_path_relative)){
								                    $college_logo=$college_logo->media_disk_path_relative;
								                    $college_logo_name=$college_logo->media_org_name;
								                }else{
								                    $college_logo=base_url().'uploads/app/default/no.jpeg';
								                    $college_logo_name='';
								                }


								                if(!empty($college_banner) && !empty($college_banner->media_disk_path_relative)){
								                    $college_banner=$college_banner->media_disk_path_relative;
								                    $college_banner_name=$college_banner->media_org_name;
								                }else{
								                    $college_banner=base_url().'uploads/app/default/pageBnr.jpg';
								                    $college_banner_name='';
								                }

								                $college_data[]=array(
							                        'college_name'=>$value->college_name,
							                        'college_city'=>$value->city_name,
							                        'college_state'=>$value->state_name,
							                        'college_logo'=>$college_logo,
							                        'college_banner'=>$college_banner,
							                        'college_course_full_name'=>$value->course_name,
							                        'college_course_short_name'=>$value->course_short_name,
							                        'college_course_placement'=>$value->user_course_placement_type,
							                        'college_course_duration'=>$value->user_course_duration_year.' yrs.',
							                        'college_course_duration_type'=>$value->user_course_duration_type,
							                        'access_url'=>$value->access_url
							                    );
											//}												
										}
									    	
									}
								}

								$thanks_modal_data=array(
									'thanks_heading'=>'Thank you',
									'thanks_msg'=>'Thanks for your interest.We will contact you shortly with one of our consultants to guide you through the process.',
									'thanks_msg_second'=>'Please check for mails in your SPAM folder of your inbox.',
									'colleges_of_interest'=>$college_data
								);

								$return['success']=$thanks_modal_data;
							}else{
								$return['error']='OTP is not valid.Hence it can not be verified.';
							}

						}else{
							$return['error']='OTP is not valid.Hence it can not be verified.';
						}
					}else{
						$return['error']=validation_errors();
					}
						

				}else{
					$return['error']='Apllication data not found';
				}
					

			}else{
				$return['error']='data manipulation not allowed';
			}


			header('Content-Type: application/json');

			echo json_encode($return);

		}else{
			redirect(base_url());
		}
	}


	public function onRegisterUserQuery(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){
			$ctext=post_data('ctext');

			$security_token = $this->data['security_token'];
			$decrypted = CryptoJsAes::decrypt($ctext, $security_token);
			
			$query_user_full_name=clean_data($decrypted['query_user_full_name']);
			$query_user_email=clean_data($decrypted['query_user_email']);
			$query_user_ph=clean_data($decrypted['query_user_ph']);
			$query_city=clean_data($decrypted['query_city']);
			$query_course=clean_data($decrypted['query_course']);
			$query_message=clean_data($decrypted['query_message']);
			//$query_country=clean_data($decrypted['query_country']);

			$current_date=date('Y-m-d');

			$data_to_insert=array(
				'enquiry_type'=>'course',
				'enquiry_type_id'=>decode_data($query_course),
				'enquiry_type_value'=>'',
				'enquiry_user_fullname'=>$query_user_full_name,
				'enquiry_user_email'=>$query_user_email,
				'enquiry_city_id'=>decode_data($query_city),
				'enquiry_city_name'=>'',
				'enquiry_country_id'=>'99',
				'enquiry_message'=>$query_message
			);

			$inserted=$this->sm->store_query($data_to_insert);

			if($inserted){
				$return['success']='Query submitted successfully.Our representative will get back to you soon.';
			}else{
				$return['error']='There is a system error.Try after some time';
			}

			header('Content-Type: application/json');

			echo json_encode($return);

		}else{
			redirect(base_url());
		}
	}


	public function onRegisterJobApplicant(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){

			$fullename=post_data('applicant_full_name');
			$email=post_data('applicant_email');
			$ph=post_data('applicant_ph');
			$state=post_data('applicant_state');
			$pincode=post_data('applicant_pincode');
			$address=post_data('applicant_address');

			$type=post_data('applicant_type');
			$role=decode_data($type);

			$temp_user=$this->um->get_user_temp_duplicate(array('temp_user_email'=>$email),array('temp_user_phone'=>$ph));

			if($temp_user[0]->counted=='0'){

				if($role=='5'){
					$role_name='Data Entry Operator';
				}else if($type=='6'){
					$role_name='Content Writer';
				}

				$password='Password@123';

				

				$temp_data=array(
					'temp_user_role'=>$role,
					'temp_user_role_name'=>$role_name,
					'temp_user_name'=>$fullename,
					'temp_user_email'=>$email,
					'temp_user_phone'=>$ph,
					'temp_user_password'=>''
				);

			}else{
				$return['error']='Email or Phone no already taken.';
			}

			header('Content-Type: application/json');

			echo json_encode($return);

		}else{
			redirect(base_url());
		}
	}


	public function onAddApllicationQuestion(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){
			$application_id=post_data('_application');

			$_applicant_question=post_data('_applicant_question');

			if(!empty($application_id) && !is_null($application_id)){
				$app_id=decode_data($application_id);

				//echo $app_id;

				$applicant_found=$this->um->get_applicant(array('application_id'=>$app_id));

				//print_obj($applicant_found);die;
				$current_date=date('Y-m-d');

				$city_data=$this->com->get_city(array('city_id'=>$applicant_found->applicant_city_id));

				$data_to_insert=array(
					'enquiry_type'=>'institute_application',
					'enquiry_type_id'=>$app_id,
					'enquiry_type_value'=>null,
					'enquiry_user_fullname'=>$applicant_found->applicant_name,
					'enquiry_user_email'=>$applicant_found->applicant_email,
					'enquiry_city_id'=>$applicant_found->applicant_city_id,
					'enquiry_city_name'=>$city_data->city_name,
					'enquiry_country_id'=>$applicant_found->applicant_country_id,
					'enquiry_message'=>$_applicant_question
				);

				$inserted=$this->sm->store_query($data_to_insert);

				if($inserted){
					$return['success']='Your question has been submitted successfully. One of our consultants will reach out to you shortly.';
				}else{
					$return['error']='Question not submitted.';
				}
			}else{
				$return['error']='Question not submitted';
			}

			header('Content-Type: application/json');

			echo json_encode($return);	

		}else{
			redirect(base_url());
		}
	}




	public function onClaimInstitutes(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){	
			
			$claimer_country=post_data('claimer_country');
			$claim_institute=post_data('claim_institute');
			$claim_institute_type=post_data('claim_institute_type');
			$claimer_full_name=post_data('claimer_full_name');
			$claimer_email=post_data('claimer_email');
			$claimer_ph=post_data('claimer_mobile_no');
			$claimer_designation=post_data('claimer_designation');
			$claimer_referer=post_data('claimer_referer');
			$claimer_referer_ph_no=post_data('claimer_referer_ph_no');
			$claimer_linkedin_profile_link=post_data('claimer_linkedin_profile_link');
			$institute_phone_no=post_data('claimer_inst_landline_no');
			$institute_phone_no_ext=post_data('claimer_inst_landline_ext');


			$this->form_validation->set_rules('claimer_full_name', 'Full Name', 'trim|required',array('required' => 'Enter %s.'));
			$this->form_validation->set_rules('claimer_email', 'Email address', 'trim|required',array('required' => 'Enter email %s.'));
			$this->form_validation->set_rules('claimer_mobile_no', 'Mobile No', 'trim|required',array('required' => 'Enter %s.'));

			if ($this->form_validation->run() == TRUE){

				if(!empty($claim_institute_type) && !empty($claimer_country) && !empty($claimer_designation)){
					$institute_type=decode_data($claim_institute_type);
					$institute_id=decode_data($claim_institute);
					$country_id=decode_data($claimer_country);
					$designation_id=decode_data($claimer_designation);

					if(is_numeric($institute_type) && is_numeric($institute_id) && is_numeric($country_id) && is_numeric($designation_id)){
						$otp =gen_otp_code();
						$ph_otp=gen_otp_code();

						$country_data=$this->com->get_country(array('country_id'=>$country_id));

						if($institute_type=='7'){
							$institute_data=$this->im->get_college_profile_data(array('college_id'=>$institute_id));
							$institute_name=$institute_data->college_name;
							$institute_access_url=$institute_data->access_url;
						}

						if(isset($this->data['system_general_settings']->system_logo) && $this->data['system_general_settings']->system_logo!=''){
							$logo=$this->data['system_general_settings']->system_logo;
						}else{
							$logo='';
						}
						
						$mail_data['from']='noreply@waytoadmissions.com';
						$mail_data['from_name']='WayToAdmissions';
						$mail_data['to']=$claimer_email;
						$mail_data['subject']='WayToAdmissions:Claim '.$institute_name.' college';
						$mail_data['data']=array(
							'system_logo'=>$logo,
							'system_name'=>'WayToAdmissions',
							'system_hr_email'=>'noreply@waytoadmissions.com',
							'system_facebook_link'=>$this->data['system_social_settings']->system_facebook_link,
							'system_instagram_link'=>$this->data['system_social_settings']->system_instagram_link,
							'system_linkedin_link'=>$this->data['system_social_settings']->system_linkedin_link,
							'system_youtube_link'=>$this->data['system_social_settings']->system_youtube_link,
							'system_twitter_link'=>$this->data['system_social_settings']->system_twitter_link,
							'system_twitter_image'=>base_url().'uploads/app/default/image-2.png',
							'system_facebook_image'=>base_url().'uploads/app/default/image-4.png',
							'system_linkedin_image'=>base_url().'uploads/app/default/image-5.png',
							'system_youtube_image'=>base_url().'uploads/app/default/image-6.png',
							'system_instagram_image'=>base_url().'uploads/app/default/image-7.png',
							'welcome_image'=>base_url().'uploads/app/default/image-10.gif',
							'user_full_name'=>$claimer_full_name,
							'verification_code'=>$otp,
							'today_date'=>date('F d,Y')
						);


						$sms_data=array(
							'flow_id'=>"61246d38163f8d707f23807f",
							'sender'=>"NCRIPT",
							'mobiles'=>$country_data->country_phone_code.$applicant_ph,
							'user_name'=>'Applicant',
							'otp_code'=>$otp,
							'web_link'=>base_url()
						);

						$sms_param['url']='https://api.msg91.com/api/v5/flow/';
						$sms_param['headers']=array("authkey: 197850AFrGnNLUa5a816402","content-type: application/JSON");
						$sms_param['data']=$sms_data;

						//print_obj($mail_data);die;

						$mail_data['view']='_email/vw_claim_institute_verification_mail';


						$claimer_data=$this->um->get_claimer(array('institute_id'=>$institute_id,'institute_type'=>$institute_type,'claimer_email'=>$claimer_email,'claimer_mobile_no'=>$claimer_ph));

						if(empty($claimer_data)){

							$data_to_insert=array(
								'institute_id'=>$institute_id,
								'institute_type'=>$institute_type,
								'institute_name'=>$institute_name,
								'institute_phone_no'=>$institute_phone_no,
								'institute_phone_no_ext'=>$institute_phone_no_ext,
								'claimer_email'=>$claimer_email,
								'claimer_mobile_no'=>$claimer_ph,
								'claimer_name'=>$claimer_full_name,
								'claimer_country'=>$country_data->country_id,
								'claimer_linkedin_profile'=>$claimer_linkedin_profile_link,
								'claimer_designation'=>$designation_id,
								'claimer_referer'=>$claimer_referer,
								'claimer_referer_ph_no'=>$claimer_referer_ph_no,
								'created_at'=>date('Y-m-d'),
								'claimer_verified'=>'no',
								'claimer_code'=>$otp,
								'claimer_ph_code'=>$ph_otp
							);

							//print_obj($data_to_insert);die;

							$added=$this->um->add_claimer_data($data_to_insert);

							if($added){
								//send_system_mail($mail_data,'html');

								//$sent=curl_post($sms_param);

								$return['success']='Your request for claiming this college has been sent to the admin for approval. You will receive a mail after approval.';//'A 6 digit One-Time Password has been sent to '.$claimer_email;
								$return['redirect']=$institute_access_url;
							}else{
								$return['error']='Request can not be served at this momment.Try later';
							}

						}else{
							if($claimer_data->claimer_verified=='yes'){
								$return['error']='You have already claimed this college.Our representative will get back to you soon.';
							}else{
								send_system_mail($mail_data,'html');
								$return['success']='You have already claimed for this college.A 6 digit One-Time Password has been sent to '.$claimer_email;
							}
						}
					}else{
						$return['error']='Data manipulation is not allowed';
					}

						
				}else{
					$return['error']='Data manipulation is not allowed';
				}
					
			}else{
				$return['error']='All (*) marked fields are required.';
			}

			header('Content-Type: application/json');

			echo json_encode($return);

		}else{
			redirect(base_url());
		}
	}

	//College Page
	public function indexCollegeRegisterPage(){
		if(!session_userdata('isUserLoggedin') && !session_userdata('user_id')){
			$segment_1=$this->uri->segment(1,0);//signup
			$segment_2=$this->uri->segment(2,0);//"colleges"

			if((is_string($segment_1) && ($segment_1!='0' && $segment_1=='signup')) && (is_string($segment_2) && ($segment_2!='0' && $segment_2=='college'))){

				$institue_types=$this->im->get_institute_types(array('inst_data_type'=>'4'),FALSE);

				if(!empty($institue_types)){
					foreach ($institue_types as $key => $value) {					
						$selected=(isset($college_data) && !empty($college_data) && ($college_data->user_type==$value->inst_type))?'selected':'';
						$_institue_types[]=array(
							'inst_type'=>encode_data($value->inst_type),
							'inst_type_name'=>$value->inst_type_name,
							'selected'=>$selected
						);
					}
				}else{
					$_institue_types=array();
				}

				$this->data['institue_types']=$_institue_types;


				$page_title=$this->data['page_title'];
				$view_page='account/college/vw_register_colleges_page';

				$this->theme->title($page_title)->load($view_page, $this->data);

			}else{
				redirect(base_url());
			}
		}else{
			redirect(base_url().'account/settings');
		}
			
	}

