	function __construct()
	{

		parent::__construct();

	    // $this->load->model(array('settings_model'=>'sm','user_model'=>'um','stream_model'=>'strm','institution_model'=>'im','country_model'=>'com'));

	    $this->load->model(array('user_model'=>'um','stream_model'=>'strm'));
