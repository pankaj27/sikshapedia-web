									'user_password_visible'=>encode_data($register_university_password),
									'user_blocked'=>'1',
									'user_approved'=>'2',
									'user_email_verified'=>'2',
									'user_phone_no_verified'=>'2',
									'user_otp'=>$otp,
									'user_mail_otp'=>$mail_otp,
									'user_top_sent_date'=>date('Y-m-d H:i:s'),
									'created_by'=>'0',
									'created_by_type'=>'3',
									'user_created_through'=>'1',
									'user_sent_from'=>'normal',
									'user_otp_sent_count'=>'1',
									'user_registration_type'=>'self',					
									'user_currency'=>($country_data->country_currency!='')?$country_data->country_currency:'4'
								);

								$user_pk_id=$this->um->add_user_data($university_user_data,FALSE,FALSE);

								if($user_pk_id){
									$this->im->update_universities_data(array('university_user_id'=>$user_pk_id),array('university_id'=>$user_profile_pk_id));
									$_slug_value=$register_university_name.' '.$city_data->city_name.' '.$state_data->state_name;
