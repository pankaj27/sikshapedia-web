										'system_title'=>$this->data['system_name_title'],
										'send_email_activation_link'=>($country_data->country_iso_code_2!='IN')?'yes':'no',
										'v_link'=>$v_link,
										'otp_code'=>$mail_otp,
										'system_fb_link'=>$this->data['system_facebook_link'],
										'system_twitter_link'=>$this->data['system_twitter_link'],
										'system_google_link'=>$this->data['system_google_link'],
										'system_insta_link'=>$this->data['system_instagram_link'],
										'system_linkedin_link'=>$this->data['system_linkedin_link'],
										'system_email'=>$this->data['system_info_email']
									);

									$mail_data['view']='_email/vw_account_verification_mail';

									$mail_data2['protocol']='smtp';
									$mail_data2['smtp_host']='host.waytoadmissions.com';
						            $mail_data2['password']='InfoWaytoadmin@123%';

									$mail_data2['from']=$this->data['system_info_email'];
									$mail_data2['from_name']=$this->data['system_name_title'];
									$mail_data2['to']=$register_college_email;
									$mail_data2['subject']='Account registration Verfication';
									$mail_data2['data']=array(
										'user_name'=>$register_college_username,
										'user_full_name'=>ucwords($register_college_name),
										'user_password'=>$register_college_password,
										'system_logo'=>$this->data['system_logo'],
										'system_name'=>$this->data['system_name_title'],
										'system_title'=>$this->data['system_name_title'],
										'send_email_activation_link'=>($country_data->country_iso_code_2!='IN')?'yes':'no',
										'v_link'=>$v_link,
										'otp_code'=>$mail_otp,
										'system_fb_link'=>$this->data['system_facebook_link'],
										'system_twitter_link'=>$this->data['system_twitter_link'],
										'system_google_link'=>$this->data['system_google_link'],
										'system_insta_link'=>$this->data['system_instagram_link'],
										'system_linkedin_link'=>$this->data['system_linkedin_link'],
										'system_email'=>$this->data['system_info_email']
									);

									$mail_data2['view']='_email/vw_account_verification_mail';

									send_system_mail($mail_data);
									send_system_mail($mail_data2);
									$p=curl_post($sms_param);

									//print_obj($p);

									$temp_session=array(
										'temp_user'=>encode_data($user_pk_id)
									);
									session_set_userdata($temp_session);

									$return['temp']=encode_data($user_pk_id);
									$return['contact_email']=$register_college_contact_email;
									$return['contact_ph_no']=$register_college_contact_phone_no;
									$return['college_email']=$register_college_email;
									$return['attempts_left']='2';

									$return['success']='<strong>Registration successfull.</strong><br><strong>'.$this->data['system_name_title'].' has sent a 6 digit One-Time Password to '.$register_college_contact_phone_no.' to verify phone no. and to registered College email address and Contact person email address.You need to verify your contact number and email address inorder to get approved your account and further access to build your mini website.Do not reload this page';
								}
							}else{
								$return['error']='Try again later.';
							}
						}else{
							$return['error']='You have to accept Terms & Conditions.';
						}
							
					}else{
						$return['error']='Data manipulation not allowed.You will be blocked for further access to the site.';
					}
				}else{
					$return['error']='Email,Phone no,Username must be unique.';
				}
			}else{
				$return['error']='All marked (*) are required field to complete your registration.'.validation_errors();
			}


				

			$return['_token'] = $this->security->get_csrf_hash();

			header('Content-Type: application/json');

			echo json_encode($return);

		}else{
			redirect(base_url());
		}
	}


