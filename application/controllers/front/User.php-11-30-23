	public function onSendOTPData(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){
			$temp_user_id=post_data('temp');

			if(is_string($temp_user_id) && !empty($temp_user_id)){
				$user_id=decode_data($temp_user_id);
			}else{
				$user_id=decode_data(session_userdata('temp_user'));
			}

			//echo $user_id;die;

			$user_data=$this->um->get_user(array('user_id'=>$user_id));

			$current_date=date('Y-m-d');

			if(!empty($user_data)){
				$otp_date=date('Y-m-d',strtotime($user_data->user_top_sent_date));

				if($current_date==$otp_date){

					$otp_limit=$user_data->user_otp_resend_limit;


					if($user_data->user_otp_sent_count<=$otp_limit){
						if($user_data->user_role=='3'){
							$user_profile_data=$this->im->get_university_data(array('university_user_id'=>$user_id));
							$country_id=$user_profile_data->university_country_id;
							$user_fullname=$user_profile_data->university_name;
							$contact_person_no=$user_profile_data->university_contact_person_phone;
						}else if($user_data->user_role=='4'){
							$user_profile_data=$this->um->get_college_profile_data(array('college_user_id'=>$user_id));
							$country_id=$user_profile_data->college_country_id;
							$user_fullname=$user_profile_data->college_name;
							$contact_person_no=$user_profile_data->college_contact_person_phone;
						}else if($user_data->user_role=='8'){
							$user_profile_data=$this->um->_get_user_data(array('user_m_id'=>$user_id));

							//print_obj($user_profile_data);die;
							$country_id=$user_profile_data->user_country;
							$user_fullname=$user_profile_data->user_fullname;
							$contact_person_no=$user_profile_data->user_phone_no;
						}

						$otp=gen_otp_code(4);
						$country_data=$this->com->get_country(array('country_id'=>$country_id));

						$this->um->update_user_data(array('user_otp'=>$otp),array('user_id'=>$user_id));

						$ph=$country_data->country_phone_code.$contact_person_no;

						sendSMS($ph,$otp);

						$_otp_limit=$user_data->user_otp_sent_count+1;
						$this->um->update_user_data(array('user_otp_sent_count'=>$_otp_limit),array('user_id'=>$user_id));
						$limt=($otp_limit-$_otp_limit);

						if($limt>0){
							$return['attempts_left']=$limt;
							$return['start_timer']=true;
						}else{
							$return['start_timer']=false;
							$return['error']='Maximum Retry attempts reached. Please try after some time.';
						}						
					}else{
						$return['start_timer']=false;
						$return['error']='Maximum Retry attempts reached. Please try after some time.';
					}
				}

			}else{
				$return['error']='User not found';
			}

			$return['_token'] = $this->security->get_csrf_hash();

			header('Content-Type: application/json');

			echo json_encode($return);

		}else{
			redirect(base_url());
		}
	}

	public function onVerifyUserAccount(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){

			$phone_otp=post_data('register_ph_otp');
			//$email_otp=post_data('register_email_otp');

			//echo $phone_otp;die;

			$user=post_data('temp');
			if(!empty($user) && is_string($user)){
				$user_id=decode_data($user);

				$user_data=$this->um->get_user(array('user_id'=>$user_id));

				if(!empty($user_data)){

					$this->form_validation->set_rules('register_ph_otp', 'OTP', 'trim|required|numeric',array('required' => 'Enter phone %s.','numeric'=>'Only numeric value allowed.'));
					//$this->form_validation->set_rules('register_email_otp', 'OTP', 'trim|required|numeric',array('required' => 'Enter email %s.','numeric'=>'Only numeric value allowed.'));

					//$result=$this->form_validation->run();
					//print_r($result);die;

					if ($this->form_validation->run() == TRUE){
						// if($user_data->user_otp==$phone_otp && $user_data->user_mail_otp==$email_otp){

						if($user_data->user_otp==$phone_otp){


							// $updated=$this->um->update_user_data(array('user_email_verified'=>'1','user_phone_no_verified'=>'1'),array('user_id'=>$user_id));

							$updated=$this->um->update_user_data(array('user_phone_no_verified'=>'1'),array('user_id'=>$user_id));

							if($updated){
								// if(session_userdata('temp_user')){
								// 	$this->session->sess_destroy();
								// }

								$session_data=array(
									'isUserLoggedin'=>true,
									'user_id'=>encode_data($user_data->user_id),
									'user_role'=>encode_data($user_data->user_role),
									'loggedin_time'=>time()
								);

								session_set_userdata($session_data);

								$user_profile_data=$this->um->_get_user_data(array('user_m_id'=>$user_data->user_id));

								// $application_data=$this->um->get_applicant(array('applicant_course_id'=>$user_profile_data->user_course_interested));

								$application_data=$this->um->get_applicant(array('applicant_ph'=>$user_profile_data->user_phone_no));								

								if(empty($application_data)){

									$applicant_state_id=(!empty($user_profile_data) && !empty($user_profile_data->user_state))?$user_profile_data->user_state:'0';
									$applicant_city_id=(!empty($user_profile_data) && !empty($user_profile_data->user_city))?$user_profile_data->user_city:'0';
									$applicant_email=(!empty($user_profile_data) && !empty($user_profile_data->user_email))?$user_profile_data->user_email:'0';

									$data_to_insert=array(
										'applicant_id'=>$user_data->user_id,
										'applicant_country_id'=>$user_profile_data->user_country,
										'applicant_state_id'=>$applicant_state_id,
										'applicant_city_id'=>$applicant_city_id,
										'applicant_course_id'=>$user_profile_data->user_course_interested,
										'application_inst_id'=>null,
										'application_inst_type'=>null,
										'applicant_name'=>$user_profile_data->user_fullname,
										'applicant_email'=>$applicant_email,
										'applicant_ph'=>$user_profile_data->user_phone_no,
										'application_mail_sent'=>'2',
										'applicant_aggreed_tc'=>'1',
										'applicantion_otp'=>$phone_otp,
										'applicant_ph_verified'=>'yes'
									);

									$inserted=$this->um->add_applicant_data($data_to_insert);
								}						


								$return['redirect']=base_url('account');
								$return['success']='Your account has been verified successfully';
							}else{
								$return['error']='OTP(s) are not valid.';
							}

						}else{
							$return['error']='OTP needs to be verified.';
						}
					}else{
						$return['error']=validation_errors();
					}

						
				}else{
					$return['error']='Data not found in the system.';
				}
			}else{
				$return['error']='Data manipulation is not allowed.Your Account will be locked.';
			}

			//rint_r($return);die;

			header('Content-Type: application/json');

			echo json_encode($return);

		}else{
			redirect(base_url());
		}
	}




	public function onRegisterCollege(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){

			$register_college_name=post_data('register_college_name');
			$register_college_email=post_data('register_college_email');
			$register_college_phone_no=post_data('register_college_phone_no');
			$register_college_country=post_data('register_college_country');
			$register_college_state=post_data('register_college_state');
			$register_college_district=post_data('register_college_district');
			$register_college_city=post_data('register_college_city');
			$register_college_university=post_data('register_college_university');
			$register_college_type=post_data('register_college_type');
			$register_college_pincode=post_data('register_college_pincode');
			$register_college_address=post_data('register_college_address');
