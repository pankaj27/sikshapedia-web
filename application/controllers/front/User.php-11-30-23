	public function onUpdateSingleData_old(){
		if(session_userdata('isUserLoggedin')==TRUE && session_userdata('user_id')){

			$ctext=post_data('ctext');

			$security_token = $this->data['security_token'];

			$decrypted = CryptoJsAes::decrypt($ctext, $security_token);

			$change_type=decode_data(clean_data($decrypted['change_type']));

			if($change_type=='password_change'){
				$current_password=clean_data($decrypted['user_current_password']);
				$new_password=clean_data($decrypted['user_new_password']);
				$user_id=decode_data(session_userdata('user_id'));

				$userdata=$this->um->get_user(array('user_id'=>$user_id));

				if(!empty($userdata)){
					if(password_verify($current_password,$userdata->user_password)){
						if($current_password!=$new_password){
							$password	=	password_hash($new_password, PASSWORD_BCRYPT, array('cost'=>12));

							$data=array('user_password'=>$password);
							$updated=$this->um->update_user_data($data,array('user_id'=>$user_id));
							if($updated){
								$return['success']='Password updated successfully';
							}else{
								$return['error']='Password can not be updated at this momment';
							}
						}else{
							$return['error']='New password can not be same as the old password';
						}
							
					}else{
						$return['error']='Current password not matched';
					}
				}else{
					$return['error']='No data found';
				}
			}else{
				$return['error']='Data error';
			}				

			header('Content-Type: application/json');

			echo json_encode($return);
		}else{
			redirect(base_url());
		}
	}


	public function onLoginUser(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){

			//$ctext=post_data('ctext');
			//$security_token = $this->data['security_token'];
			//echo $security_token;die;

			//print_obj($ctext);die;

			//echo $security_token;die;
			//$decrypted = CryptoJsAes::decrypt($ctext, $security_token);

			//print_obj($decrypted);die;

			// $user_name=clean_data($decrypted['user_name']);
			// $user_password=clean_data($decrypted['user_password']);
			// $curl=clean_data($decrypted['user_curl']);

			$user_name=post_data('user_name');
			$user_password=post_data('user_password');
			$curl=post_data('user_curl');

			$this->form_validation->set_rules('user_name', 'username', 'trim|required|min_length[8]|max_length[32]',array('required' => 'Enter %s.'));
			$this->form_validation->set_rules('user_password', 'password', 'trim|required|min_length[8]|max_length[16]',array('required' => 'Enter %s'));

			if ($this->form_validation->run() == TRUE){
				//echo $user_name;die;

				$userdata=$this->um->get_user(array('user_name'=>$user_name));

				//print_obj($userdata);die;

				if(!empty($userdata)){
					if($userdata!='' && !in_array($userdata->user_role, array(1,2))){
						if($userdata!='' && ($userdata->user_blocked==1)){
							if(password_verify($user_password,$userdata->user_password)){
								$token=token();
								$this->um->update_user_data(array('user_login_token'=>$token),array('user_id'=>$userdata->user_id));
								$session_data=array(
									'isUserLoggedin'=>true,
									'user_id'=>encode_data($userdata->user_id),
									'user_role'=>encode_data($userdata->user_role),
									'user_token'=>encode_data($token),
									'loggedin_time'=>time()
								);

								session_set_userdata($session_data);

								if($userdata->user_role=='0'){
									$return['redirect'] = base_url().'account/'.encode_data($userdata->user_id);
								}else{
									// if($curl!=''){
									// 	$return['redirect'] = $curl;
									// }else{
									// 	$return['redirect'] = base_url().'account';
									// }

									if(session_userdata('custom_redirect')){
										$return['redirect'] = session_userdata('custom_redirect');
									}else{
										if($userdata->user_role=='3'){
											$return['redirect'] = base_url().'account/settings';
										}else if($userdata->user_role=='4'){
											$return['redirect'] = base_url().'account/settings';
										}else if($userdata->user_role=='8'){
											$return['redirect'] = base_url().'account';
										}										
									}		
								}
				            	
								$return['success']='Loggedin successfully';
							}else{
								$return['redirect'] = base_url().'account';
								$return['error']='Credentials are invalid';
							}
						}else if($userdata!='' && ($userdata->user_blocked==2)){
							$return['redirect'] = base_url();
							$return['error']='Your id is deactivated.';
						}else{
							$return['redirect'] = base_url();;
							$return['error']='Credentials are invalid';	
						}
					}else{
						$return['redirect'] = base_url();
						$return['error']='Credentials are invalid';	
					}
						
				}else{
					$return['error']='User not found in the system';
				}
			}else{
				$return['error']='All marked (*) are required field to complete your registration.'.validation_errors();
			}

			header('Content-Type: application/json');

			echo json_encode($return);

		}else{
			redirect(base_url());
		}
	}

	public function onLogoutUser(){
		if(session_userdata('user_id') && session_userdata('isUserLoggedin')==TRUE){
			$user_id=decode_data(session_userdata('user_id'));
			$user_role=decode_data(session_userdata('user_role'));
			$user_data=$this->um->get_user_data(array('user_id'=>$user_id,'user_role'=>$user_role));
			$last_visited_url=($user_data->user_last_visited_page!=NULL || !empty($user_data->user_last_visited_page))?$user_data->user_last_visited_page:base_url();
			$this->session->sess_destroy();
			redirect($last_visited_url);	
		}else{
			show_404();
		}
	}


	public function onGAuthURL(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='GET'){
			$social_auth_type=$this->input->get('_social_auth');

			if($social_auth_type=='gauth'){
				$this->social->clientID=$this->data['gclientID'];
				$this->social->clientSecret=$this->data['gclientSecret'];
				$this->social->redirectUri=$this->data['redirectUri'];
				$return['auth_url']=$this->social->get_google_authurl();
			}else if($social_auth_type=='fbauth'){
				$this->social->clientID=$this->data['fbclientID'];
				$this->social->clientSecret=$this->data['fbclientSecret'];
				$this->social->redirectUri=$this->data['redirectUri'];

				echo password_hash('Password@123', PASSWORD_BCRYPT, array('cost'=>12));die;

				//echo $this->social->clientID.'<br>'.$this->social->clientSecret;die;

				//print_obj($this->social->get_fb_authurl());die;
				$return['auth_url']=$this->social->get_fb_authurl();
			}
			else{
				$return['error']='Social authentication is not supported';
			}

			header('Content-Type: application/json');

			echo json_encode($return);
		}else{
			redirect(base_url());
		}
	}


	public function onGAuthSocial(){
		$g_code=$this->input->get('code', TRUE);

		//echo $g_code;die;

		if($g_code!=null){
			$this->social->clientID=$this->data['gclientID'];
			$this->social->clientSecret=$this->data['gclientSecret'];
			$this->social->redirectUri=$this->data['redirectUri'];

			$auth_data=$this->social->google_login($g_code);

			//print_obj($auth_data);die;

			
			if(!empty($auth_data) && $auth_data!=FALSE && !empty($auth_data->email) && $auth_data->verifiedEmail=='1'){
				$user_name=$auth_data->email;
				$name =  $auth_data->name;
				$user_image_url=$auth_data->picture;

				//echo $user_name;die;
				$userdata=$this->um->get_user(array('user_name'=>$user_name));

				//print_obj($userdata);die;

				if(empty($userdata)){

					//echo $user_name;die;

					$get_temp_user_duplicate=$this->um->get_user_temp_duplicate(array('temp_user_email'=>$user_name));

					if($get_temp_user_duplicate[0]->counted=='0'){
						$password	=	password_hash('Password@123', PASSWORD_BCRYPT, array('cost'=>12));

						$data=array(
							'user_name'=>$user_name,
							'user_password'=>$password,
							'user_blocked'=>'1',
							'user_email_verified'=>'1',
							'user_created_through'=>'2'
						);

						$inserted=$this->um->add_user_data($data);

						if($inserted){
							$temp_data=array(
								'temp_user_pk_id'=>$inserted,
								'temp_user_name'=>$name,
								'temp_user_email'=>$user_name,
								'temp_user_phone'=>'',
								'temp_user_password'=>$password,
								'temp_user_country'=>'0',								
								'temp_user_system_ip'=>$this->input->ip_address(),
								'temp_user_image_url'=>$user_image_url
							);
							$temp_data_added=$this->um->add_user_temp_data($temp_data);

							$inserted_userdata=$this->um->get_user(array('user_id'=>$inserted));

							$token=token();
							$this->um->update_user_data(array('user_login_token'=>$token,'user_profile_pk_id'=>$temp_data_added),array('user_id'=>$inserted));
							$session_data=array(
								'isUserLoggedin'=>true,
								'user_id'=>encode_data($inserted),
								'user_role'=>encode_data('0'),
								'user_token'=>encode_data($token),
								'loggedin_time'=>time()
							);

							session_set_userdata($session_data);

							if($userdata->user_role=='0'){
								$redirect = base_url().'account/'.encode_data($userdata->user_id);
							}else{
								$redirect = base_url().'account';	
							}

							redirect($redirect);
						}else{
							redirect(base_url());
						}

					}else{
						$password	=	password_hash('Password@123', PASSWORD_BCRYPT, array('cost'=>12));

						$data=array(
							'user_name'=>$user_name,
							'user_password'=>$password,
							'user_blocked'=>'1',
							'user_email_verified'=>'1',
							'user_created_through'=>'2'
						);

						$inserted=$this->um->add_user_data($data);

						if($inserted){
							$temp_data=array(
								'temp_user_pk_id'=>$inserted,
								'temp_user_name'=>$name,
								'temp_user_email'=>$user_name,
								'temp_user_phone'=>'',
								'temp_user_password'=>$password,
								'temp_user_country'=>'0',								
								'temp_user_system_ip'=>$this->input->ip_address(),
								'temp_user_image_url'=>$user_image_url
							);

							$temp_data_added=$this->um->update_user_temp_data($temp_data,array('temp_user_email'=>$user_name));
							$inserted_userdata=$this->um->get_user(array('user_id'=>$inserted));

							$token=token();
							$this->um->update_user_data(array('user_login_token'=>$token,'user_profile_pk_id'=>$temp_data_added),array('user_id'=>$inserted));
							$session_data=array(
								'isUserLoggedin'=>true,
								'user_id'=>encode_data($inserted),
								'user_role'=>encode_data('0'),
								'user_token'=>encode_data($token),
								'loggedin_time'=>time()
							);

							session_set_userdata($session_data);

							if($userdata->user_role=='0'){
								$redirect = base_url().'account/'.encode_data($userdata->user_id);
							}else{
								$redirect = base_url().'account';	
							}

							redirect($redirect);
						}else{
							redirect(base_url());
						}	
					}

				}else if(!empty($userdata)){
					$token=token();
					$password	=	password_hash('Password@123', PASSWORD_BCRYPT, array('cost'=>12));
					$temp_data=$this->um->get_user_temp(array('temp_user_email'=>$user_name));
					if(!empty($temp_data)){
						$temp_data=array(
							'temp_user_pk_id'=>$userdata->user_id,
							'temp_user_name'=>$name,
							'temp_user_email'=>$user_name,
							'temp_user_phone'=>'',
							'temp_user_password'=>$password,
							'temp_user_country'=>'0',								
							'temp_user_system_ip'=>$this->input->ip_address(),
							'temp_user_image_url'=>$user_image_url
						);

						$temp_data_added=$this->um->update_user_temp_data($temp_data,array('temp_user_email'=>$user_name));
						$this->um->update_user_data(array('user_login_token'=>$token),array('user_id'=>$userdata->user_id));
					}else{
						$temp_data=array(
							'temp_user_pk_id'=>$userdata->user_id,
							'temp_user_name'=>$name,
							'temp_user_email'=>$user_name,
							'temp_user_phone'=>'',
							'temp_user_password'=>$password,
							'temp_user_country'=>'0',								
							'temp_user_system_ip'=>$this->input->ip_address(),
							'temp_user_image_url'=>$user_image_url
						);

						$temp_data_added=$this->um->add_user_temp_data($temp_data);
						$this->um->update_user_data(array('user_login_token'=>$token,'user_profile_pk_id'=>$temp_data_added),array('user_id'=>$userdata->user_id));
					}
						
			
					$session_data=array(
						'isUserLoggedin'=>true,
						'user_id'=>encode_data($userdata->user_id),
						'user_role'=>encode_data($userdata->user_role),
						'user_token'=>encode_data($token),
						'loggedin_time'=>time()
					);

					session_set_userdata($session_data);

					if($userdata->user_role=='0'){
						$redirect = base_url().'account/'.encode_data($userdata->user_id);
					}else{
						$redirect = base_url().'account';	
					}

					redirect($redirect);
				}
			}else{
				redirect(base_url());
			}
		}else{
			redirect(base_url());
		}
