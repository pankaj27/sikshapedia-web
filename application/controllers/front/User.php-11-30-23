	public function onResetAccount(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){

			$register_ph_otp=post_data('register_ph_otp');

			$register_conf_new_pass=post_data('register_conf_new_pass');

			$userdata=$this->um->get_user_data(array('user_reset_otp'=>$register_ph_otp));

			if($userdata){

				$password	=	password_hash($register_conf_new_pass, PASSWORD_BCRYPT, array('cost'=>12));
				$token=token();

				$updated=$this->um->update_user_data(array('user_login_token'=>$token,'user_reset_otp'=>'','user_password'=>$password,'user_password_visible'=>encode_data($register_conf_new_pass)),array('user_id'=>$userdata->user_m_id));

				if($updated){

					$session_data=array(
						'isUserLoggedin'=>true,
						'user_id'=>encode_data($userdata->user_id),
						'user_role'=>encode_data($userdata->user_role),
						'user_token'=>encode_data($token),
						'loggedin_time'=>time()
					);

					session_set_userdata($session_data);

					$return['redirect'] = base_url().'account';
					$return['success']='Account reset successfully';

				}else{
					$return['error']='Account data not found in the system. ';
				}

			}else{
				$return['error']='OTP is not valid';
			}


		}else{
			$return['error']='Action not allowed';
		}

		header('Content-Type: application/json');

		echo json_encode($return);
	}

	//Update Branding Ifo

	public function onUpdateSingleData(){
		if($this->input->is_ajax_request() && $this->input->server('REQUEST_METHOD')=='POST'){
			if(session_userdata('isUserLoggedin')==TRUE && session_userdata('user_id')){

				$user_id=decode_data(session_userdata('user_id'));

				$user_data=$this->data['userdata'];

				//print_obj($user_data);die;

				//echo $user_id;die;
				
				$change_type=post_data('change_type');

				if($change_type=='password_change'){
					$current_password=clean_data($decrypted['user_current_password']);
					$new_password=clean_data($decrypted['user_new_password']);
					$user_id=decode_data(session_userdata('user_id'));

					$userdata=$this->um->get_user(array('user_id'=>$user_id));

					if(!empty($userdata)){
						if(password_verify($current_password,$userdata->user_password)){
							if($current_password!=$new_password){
								$password	=	password_hash($new_password, PASSWORD_BCRYPT, array('cost'=>12));

								$data=array('user_password'=>$password);
								$updated=$this->um->update_user_data($data,array('user_id'=>$user_id));
								if($updated){
									$return['success']='Password updated successfully';
								}else{
									$return['error']='Password can not be updated at this momment';
								}
							}else{
								$return['error']='New password can not be same as the old password';
							}
								
						}else{
							$return['error']='Current password not matched';
						}
					}else{
						$return['error']='No data found';
					}
				}else if($change_type=='branding_change'){
					$slug_type=($user_data->user_role=='4')?'7':'6';
					$slug_found=$this->sm->get_slug(array('slug_type_id'=>$user_id,'slug_type'=>$slug_type));

					//print_obj($slug_found);die;


					$folder_name=$slug_found->slug_value;
					$response_error='';
					$response_success='';
					if(isset($_FILES['file_logo_image']) && $_FILES['file_logo_image']['name']!=''){

						//echo 'hio';die;

						list($width, $height, $type, $attr) = getimagesize($_FILES['file_logo_image']['tmp_name']);

						if($width>=500 && $height>=500){
							$file_logo_found=$this->sm->get_user_file(array('user_storage_type'=>'user_logo','user_file_type_id'=>$user_id));

							//print_obj($file_logo_found);die;

							if(!empty($file_logo_found)){
								if(is_file($file_logo_found->media_disk_path)){
									@unlink($file_logo_found->media_disk_path);
									$this->sm->delete_file(array('storage_id'=>$file_logo_found->storage_id));
								}
							}

							$logo_data=array(
								'file_size'=>'4',
								'file_name'=>'file_logo_image',
								'file_types'=>'png,jpg,jpeg',
								'file_folder'=>'colleges',
								'file_child_folder'=>$folder_name,
								'file_uploaded_by'=>$user_id,
								'file_compress'=>true,
								'file_compress_protocol'=>'webp'
							);

							//print_obj($logo_data);die;

							$file_id=$this->onUploadFiles($logo_data);

							if(!empty($file_id) && is_numeric($file_id) && $file_id>0){

								$this->sm->delete_user_file(array('user_file_type_id'=>$user_id,'user_storage_type'=>'user_logo'));

					            $user_logo_storage_data=array(
					            	'user_file_storage_id'=>$file_id,
					            	'user_file_type_id'=>$user_id,
					            	'user_file_type'=>$user_data->user_role,
					            	'user_storage_type'=>'user_logo'
					            );

					            $this->sm->store_user_file($user_logo_storage_data);

					            $response_success.='Logo updated successfully.';
					        }else{
					        	$response_error.=$file_id;
					        }
						}else{
							$response_error.='For the best results on all devices, use an image that’s at least 500 x 500 pixels and 6MB or less.Selected file is '.$width.'x'.$height+' pixels';
						}							
					}

					if(isset($_FILES['file_cover_image']) && $_FILES['file_cover_image']['name']!=''){

						//echo 'hi2';die;

						list($width, $height, $type, $attr) = getimagesize($_FILES['file_cover_image']["tmp_name"]);

