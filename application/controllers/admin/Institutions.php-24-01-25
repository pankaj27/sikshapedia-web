					$inner_menu_alias=array();
				}
            }else{
				$inner_menues=array();
				$inner_menu_alias=array();
			}


			$college_genere=array('none'=>'None','coed'=>'Coed','girls'=>'Girls');


			foreach ($college_genere as $key => $value) {
				$_college_genere[]=array(
