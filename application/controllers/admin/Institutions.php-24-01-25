				$slug_found=$this->sm->get_slug(array('slug_type_id'=>$college_id,'slug_type'=>'7'));

				$college_data=$this->im->get_college_profile_data(array('college_user_id'=>$college_id));

				$folder_name=$slug_found->slug_value;

