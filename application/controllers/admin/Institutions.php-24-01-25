				$_designations=array();
				$_departments=array();
				$gallery_types=array();
				$hostel_data=array();
			}

			if(isset($cid)){
				$info=$this->im->get_inst_info_data(array('info_type'=>'2','info_type_id'=>$cid));
				$college_general_info=$info->info_value;
