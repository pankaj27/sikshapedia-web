					'url_meta_desc'=>$meta_desc,
					'url_og_title'=>$page_heading,
					'url_og_desc'=>$meta_desc,
					'url_page_heading'=>$page_heading,
					'url_breadcrumb'=>json_encode($breadcrumb),
					'url_value'=>$college_data->access_url,
					'url_type_in_notification'=>'no',
					'url_priority'=>'0.8',
