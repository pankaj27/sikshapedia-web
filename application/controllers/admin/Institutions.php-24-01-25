					$_p=array('user_id'=>$value->college_user_id,'course_id'=>$course_id);
				}else{
					$_p=array('user_id'=>$value->college_user_id);
				}	


				$exam_ids_data=$this->strm->_get_user_course_exam_groupconcat($_p);	

				//print_obj($exam_ids_data);  

