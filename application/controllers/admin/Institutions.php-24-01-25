					'rank_value'=>$value->rank_value,
					'selected'=>(isset($crbodies) && in_array($value->rank_id, $crbodies))?'selected':''
				);
			}

			//print_obj($_rank_bodies);die;

			foreach ($ranking_categories as $key => $value) {
