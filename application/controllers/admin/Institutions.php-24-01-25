		    ]
		  }
		}';


		$breadcrumb_struct_data=$this->sm->get_slug_struct_data(array('slug_url'=>$college_data->access_url,'slug_type_json_ld'=>'BreadcrumbList'));

		if(empty($breadcrumb_struct_data)){

