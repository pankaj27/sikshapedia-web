				}

				$this->data['cranking_values']=$cranking_values;
			}else{
				$this->data['cranking_values']=array();
			}


			foreach ($ranking_bodies as $key => $value) {
				$_rank_bodies[]=array(
					'id'=>$value->rank_id,
					'rank_body_id'=>encode_data($value->rank_id),
