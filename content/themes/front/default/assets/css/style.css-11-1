.our-team .pic img{width:100%;height:auto;transition:all .2s ease-in-out}
.our-team:hover img{transform:scale(1.1,1.1)}
.our-team .over-layer{position:absolute;left:0;bottom:-100%;width:100%;height:100%;padding:25px 15px;background:rgba(232,82,46,0.6);transition:all .2s ease-in-out}
.our-team:hover .over-layer{bottom:0}
.our-team .description{font-size:14px;color:#fff}
.our-team .social-link{padding:0;margin:0;list-style:none;position:absolute;bottom:8%;left:8%}
.our-team .social-link li{display:inline-block}
.our-team .social-link li a{border:1px solid #fff;width:25px;height:25px;color:#EF6C00;background:#fff;line-height:25px;text-align:center;transition:all .3s ease 0}
.our-team .social-link li a:hover{text-decoration:none;color:#333}
.our-team .team-prof{text-align:center;padding:15px;margin:0}
.our-team .team-prof h3 a{color:#333;font-size:16px;letter-spacing:1px;text-transform:uppercase}
.our-team .team-prof h3 a:hover{text-decoration:none;color:#EF6C00}
.our-team .team-prof small{color:#EF6C00;display:block;font-size:12px;margin-top:3%;text-transform:uppercase}
.counterBox{padding:0 20px 20px;text-align:center;z-index:1;position:relative}
.counterBox:after{content:"";width:100%;height:75%;background:#1b1f4c;position:absolute;bottom:0;left:0;z-index:-1;transition:all .3s ease 0}
.counterBox .counter-content{width:100%;height:100%;background:#f1f1f1;padding:25px 0;margin-bottom:15px;overflow:hidden;z-index:1;position:relative;-webkit-clip-path:polygon(100% 0,100% 85%,80% 85%,70% 100%,60% 85%,0 85%,0 15%);clip-path:polygon(100% 0,100% 85%,80% 85%,70% 100%,60% 85%,0 85%,0 15%)}
.counterBox .counter-icon{font-size:40px;color:#1b1f4c;transform:rotateX(360deg);transition:all .3s ease 0}
.counterBox:hover .counter-icon{transform:rotateX(0)}
.counterBox .counter-value{display:block;font-size:30px;font-weight:700;color:#EF6C00;margin:0 0 60px}
.counterBox .title{font-size:19px;font-weight:600;color:#fff;text-transform:uppercase;margin:0}
.iconTab .nav-tabs{position:relative;flex-wrap:nowrap}
.iconTab .nav-tabs li{margin:0}
.iconTab .nav-tabs li a{display:block;padding:100px 20px 10px;background:#fff;font-size:13px;font-weight:700;color:#999;text-transform:uppercase;text-align:center;border-radius:0;border:none;border-bottom:2px solid #fff;margin-right:0;overflow:hidden;z-index:1;position:relative;transition:all .3s ease;min-width:120px}
.iconTab .nav-tabs li a .icon{display:block;width:60px;height:60px;line-height:60px;background:#f2f2f2;margin:auto;font-size:22px;color:#999;border-radius:5px;position:absolute;top:10px;left:0;right:0;transform:rotate(45deg)}
.iconTab .nav-tabs li a.active .icon{background:#29335c;color:#fff;box-shadow:0 0 5px 0 rgba(0,0,0,0.16)}
.iconTab .nav-tabs li a .icon i{transform:rotate(-45deg);font-size:30px}
.iconTab .nav-tabs li a .icon svg{transform:rotate(-45deg);width:40px}
.iconTab .nav-tabs li a.active,.iconTab .nav-tabs li a:hover{color:#EF6C00;border:none;border-bottom:2px solid #fff}
.iconTab .nav-tabs li a.active{border-bottom:2px solid #EF6C00}
.adBlock img{max-width:100%}
.bodyslot{margin:10px 0!important;padding:15px!important;background:#f5f8f9!important;overflow:hidden!important;margin-top:10px!important;clear:both!important}
