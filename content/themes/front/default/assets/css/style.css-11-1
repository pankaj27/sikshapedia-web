.logSignSec .logSignContent{display:flex;justify-content:space-between;flex-wrap:wrap;position:relative}
.logSignSec .logSignContent .secLeft{flex:0 0 40%;background:#fff;padding:70px 0 150px;box-shadow: 1px 0px 5px 0 rgb(0 0 0 / 20%);
}
.logSignSec .logSignContent .secRight{flex:0 0 60%;background:#f5f5f5;padding:70px 0 150px}
.logSignSec .logSignContent .secFull{flex:0 0 100%;background:#fff;padding:70px 0 150px}
.logSignSec .logSignContent .secInner{overflow-y:auto;max-height:calc(100vh - 150px);padding:0 20px}
.logSignSec .logSignContent .secLeft .text-white{ color: #1b1f4c !important }
