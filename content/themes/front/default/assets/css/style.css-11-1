.slick-prev, .slick-next{
	width: 35px; height: 35px; z-index: 10;
	background: #f0f0f0; border-radius: 50%; 
	box-shadow: 0 2px 2px 0 rgb(0 0 0 / 14%), 0 3px 1px -2px rgb(0 0 0 / 12%), 0 1px 5px 0 rgb(0 0 0 / 20%);
}

.slick-prev:before,.slick-next:before{
    content: '' !important;
    width: 10px; height: 10px;
    position: absolute; top: 50%; left: 50%;
}
.slick-prev:before{
	 border-top: 1px solid #37474f;
    border-left: 1px solid #37474f;
    transform: translate(-50%,-50%) rotate(-45deg);
}
.slick-next:before{
	 border-top: 1px solid #37474f;
     border-right: 1px solid #37474f;
    transform: translate(-50%,-50%) rotate(45deg);
}
.slick-prev:hover, .slick-prev:focus, .slick-next:hover, .slick-next:focus {
    background: #fff;
}

.studyAbroadSection .slick-next{ right: 10px }
.studyAbroadSection .slick-prev{ left: 10px }

.solial{display: flex; align-items: center; justify-content: center;}
.solial a{
  font-size: 16px; 
  color: #e8522e;
  float: left;
  width: 38px;
  height: 38px;
  background: #e8522e26;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50px;
  transition: all 0.3s ease-in-out;
  text-decoration: none;
}
