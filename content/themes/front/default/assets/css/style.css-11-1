.chosen-container{font-size:14px; z-index: inherit !important;}
.chosen-container-single .chosen-single div{top:7px;width:18px;height:18px}
.chosen-container-single .chosen-single{padding:0 0 0 10px;height:33px;border:1px solid #ced4da;border-radius:0;background-color:#fff;background:-webkit-gradient(linear,left top,left bottom,color-stop(20%,#fff),color-stop(50%,#fff),color-stop(52%,#fff),to(#fff));background:linear-gradient(#fff 20%,#fff 50%,#fff 52%,#fff 100%);background-clip:padding-box;-webkit-box-shadow:none;box-shadow:none;color:#333!important;line-height:33px}
.chosen-container .chosen-results li.highlighted{background-color:#1b1f4c;background-image:-webkit-gradient(linear,left top,left bottom,color-stop(20%,#1b1f4c),color-stop(90%,#1b1f4c));background-image:linear-gradient(#1b1f4c 20%,#1b1f4c 90%)}
.listStreamsCard .card-body{min-height: 175px;}
.listStreamsCard .card-header{display:flex;align-items:center;background:#fff}
.listStreamsCard .card-header a h5{color:#1b1f4c;font-size:18px}
.listStreamsCard .card-header .icon svg{width:auto;height:20px;margin-right:10px}
.listStreamsCard .card-header .icon svg path{fill:#f57b32}
.listStreamsCard .card-body{height:130px; overflow-y: auto; padding-bottom: 50px; position: relative;}
.listStreamsCard .card-body .btn-primary.btn-block { position: absolute; bottom: 15px; left: 15px; width: calc(100% - 30px) }
.examBnrSec{position:relative;z-index:1;min-height:400px;background-color:#3b5998}
.examBnrSec .examBnrImg{width:100%;height:100%;object-fit:cover;position:absolute;top:0;left:0;z-index:-1;position:absolute;top:0;left:0}
.examBnrSec:after{content:'';position:absolute;top:0;left:0;width:100%;height:100%;z-index:-1;background:linear-gradient(to bottom,rgba(0,0,0,0.7) 0%,rgba(0,0,0,0.2) 50%,rgba(0,0,0,0.7) 100%)}
.examBnrSec .eaxmBannerContent{position:relative;width:100%;height:100%}
.examBnrSec .eaxmBannerContent .searchPanelBox{max-width:580px;width:100%;margin:0 auto;padding:50px 0}
#examSearchClose{width:48px;height:48px;background:#fff;border:0;box-shadow:none;padding:14px;border-radius:0;position:absolute;top:1px;right:1px;z-index:99;outline:none;transition:all .3s ease-in-out;display:none}
#examSearchClose svg{width:100%;height:auto}
#examSearchClose:hover{box-shadow:0 2px 5px 0 #000 0 2px 10px 0 #000}
.examMedia{border:1px solid #ffa726;transition:all .4s ease-in-out;display:flex;text-decoration:none!important}
.examMedia:hover{background:#1b1f4c;border:1px solid #1b1f4c}
.examMedia .exmDate{padding:15px;text-align:center}
.exmBbody{padding:15px;display:flex;flex-direction:column;align-items:center}
.searchCategorySec{display:none}
.searchCategorySec .btnGroup .btn{margin-bottom:10px;margin-right:10px}
.examSearchWrapper{transition:all .4s ease}
.examSearchActive{overflow:hidden}
.examSearchActive #examSearchClose,.examSearchActive .searchCategorySec{display:block}
.examSearchActive .examSearchWrapper{position:fixed;top:0;left:0;width:100%;height:100vh;overflow-y:auto;z-index:9999;background:#fff;padding:30px 0 50px}
.examSearchActive .examBnrSec .eaxmBannerContent .searchPanelBox{max-width:100%;width:100%;padding:0 0 50px}
.examSearchActive .examBnrSec .eaxmBannerContent .searchPanelBox .boxTitle{display:none}
.examSearchActive .upcommingExams,.examSearchActive .examBnrSec .examBnrImg{display:none}
.examSearchActive .examBnrSec{min-height:auto;background-color:#fff}
.examSearchActive .examBnrSec:after{display:none}
.examCard{border-radius:0;position:relative}
.examCard a{text-decoration:none!important;transition:all .3s ease}
.examCard p{margin:0}
.examCard .icon svg{height: 30px; width: all;}
.examCard .icon svg path{ fill: #1b1f4c }
.examCard .card-header,.examCard .card-footer{transition:all .3s ease;background:#fff;color:#1b1f4c}
.examCard:hover .card-header,.examCard:hover .card-footer{background:#f57b32;color:#fff;border-radius:0}
.examCard .card-header svg path{transition:all .3s ease}
.examCard:hover .card-header svg path{fill:#fff}
.examCard .card-body a{color:#1b1f4c;transition:all .3s ease}
.examCard .card-body a:hover{color:#f57b32;}
.examListCard{border-radius:0}
.examListCard .examDatesInfo{position:relative;padding:10px;border:1px solid #eee}
.examListCard .examDatesInfo .examLabel{background:#f57b32;color:#fff;padding:0 5px;font-size:10px;text-align:center;position:absolute;top:-7px;left:50%;width:94%;transform:translateX(-50%);border-radius:2px}
.numberingListCard .list-group{max-height:calc(100vh - 125px);overflow-y:auto!important}
.numberingListCard .list-group .list-group-item{border-radius:0;display:flex;padding:10px;line-height:1.3}
.numberingListCard .list-group .list-group-item .number{width:35px;height:35px;line-height:35px;text-align:center;background:#eee;border-radius:50%;font-size:14px;font-weight:600;color:#333;margin-right:10px;flex:0 0 35px}
.numberingListCard .list-group .list-group-item.active{background:#fff;color:#1b1f4c;border-color:#ccc;font-weight:600}
.numberingListCard .list-group .list-group-item:hover .number,.numberingListCard .list-group .list-group-item.active .number{background:#f57b32;color:#fff}
.suggestCard .card-body{min-height:78px}
.infoCard .blockquote{background:#f6f6f6;border-left:4px solid #e8522e;padding:10px}
.serviceIcoBox{position:relative;padding:10px 15px 0}
.serviceIcoBox .ico{background:#eee;color:#fb8c00;font-size:15px;width:60px;height:60px;margin:10px auto 15px;border-radius:50%;box-shadow:inset 0 0 10px rgba(0,0,0,0.2);position:relative;transition:all .3s ease;display:flex;align-items:center;justify-content:center}
.serviceIcoBox .ico svg{width:40px;height:auto}
.serviceIcoBox .ico svg path{fill:#fb8c00}
/*.serviceIcoBox .ico:before,.serviceIcoBox .ico:after{content:"";border:1px solid #1b1f4c;border-left:1px dashed #e8522e;border-right:1px dashed #e8522e;border-radius:50%;position:absolute;top:-5px;left:-5px;bottom:-5px;right:-5px;transition:all .3s ease}*/
/*.serviceIcoBox .ico:after{transform:rotate(-45deg);top:-10px;left:-10px;bottom:-10px;right:-10px;border-color:#e8522e}*/
.serviceIcoBox:hover .ico:before{transform:rotate(-40deg)}
.serviceIcoBox:hover .ico:after{transform:rotate(40deg)}
.filterBtn{display:inline-block;text-align:center;white-space:nowrap;vertical-align:middle;user-select:none;border:1px solid transparent;padding:7px 10px;font-size:.9rem;line-height:1;color:#6c757d;background-color:transparent;background-image:none;border-color:#6c757d;outline:none!important;position:relative}
.filterBtn:hover,.filterBtn.active{color:#e8522e;background-color:transparent;border-color:#e8522e}
.filterBtn:before{content:"\f309";margin-right:7px;font-weight:900;font-family:"Font Awesome 5 Free"}
.filterBtn.active:before{content:"\f30c"}
.filterBtnGroup .filterBtn{margin-right:7px}
.select-hidden{display:none;visibility:hidden;padding-right:10px}
.customSelect{cursor:pointer;display:inline-block;position:relative;font-size:14px;color:#333;width:auto;height:auto}
.customSelect .customSelected{background-color:#f0f0f0;padding:5px 10px;transition:all .2s ease-in;padding-right:25px}
.customSelect .customSelected:after{content:"";position:absolute;top:11px;right:10px;padding:3px;display:inline-block;border-top:1px solid #607d8b;border-right:1px solid #607d8b;transform:rotate(135deg)}
.customSelect .customSelected:hover{background-color:#f0f0f0}
.customSelect .customSelected:active,.customSelect .customSelected.active{background-color:#f0f0f0}
.customSelect .customSelected:active:after,.customSelect .customSelected.active:after{transform:rotate(-45deg);top:16px}
.customSelect .selectOptions{display:none;position:absolute;top:100%;right:0;left:0;z-index:9;margin:0;padding:0;list-style:none;background-color:#f0f0f0}
.customSelect .selectOptions li{position:relative;margin:0;padding:5px 10px;border-top:1px solid #fff;-o-transition:all .15s ease-in;-webkit-transition:all .15s ease-in;transition:all .15s ease-in}
.customSelect .selectOptions li:hover{color:#333;background:#fff}
.customSelect .selectOptions li[rel="hide"]{display:none}
.customSelect .selectOptions li.selected:after{content:'';width:6px;height:6px;border-radius:50%;background:#4caf50;display:inline-block;position:absolute;right:8px;top:calc(50% - 3px)}
.reviewPanel .media .mediaImg{width:50px;height:50px;line-height:50px;text-transform:uppercase;font-weight:600;overflow:hidden;text-align:center;font-size:20px;border-radius:50%;background:#283593;color:#fff}
.reviewPanel .media .mediaImg img{width:100%;height:100%;object-fit:cover}
.reviewPanel + .reviewPanel{border-top:1px solid #ddd;padding-top:15px}

.inst_video{color:#ffffff;}

.inst_video a:hover{color:#ffffff;}

.isaSlider{position:relative;height:calc(100vh - 182px);}  
.isaSlider .swiper-slide{height:calc(100vh - 182px);overflow:hidden}
.isaSlider .swiper-slide img{width:100%;height:100%;object-fit:cover;transform:scale(1);transition:all 4s ease;transition-delay:1s}
.isaSlider .swiper-slide .slideContent{position:absolute;top:0;left:0;width:100%;height:100%;color:#fff;text-align:center;display:flex;flex-direction:column;justify-content:center;align-items:center;
    background: radial-gradient(ellipse at center, rgba(0,0,0,0) 0%,rgba(0,0,0,0.65) 100%);}
.isaSlider .swiper-button-prev,.isaSlider .swiper-button-next{position:absolute;bottom:15px;left:15px;top:auto;right:auto;height:40px;width:40px;border-radius:50%;color:#212121;background:#fafafa;border:0;outline:none;box-shadow: 0 0 10px 1px rgb(0 0 0 / 40%);
}
.isaSlider .swiper-button-prev::after,.isaSlider .swiper-button-next::after{font-size:12px}
.isaSlider .swiper-button-next{left:70px}
.isaSlider .swiper-pagination-progressbar{top:auto;bottom:0;height:2px}
.isaSlider .swiper-slide.swiper-slide-active img{transform:scale(1.1);transition-property:transform;transition-delay:500ms}
.isaSlider .isppBtn{width:40px;height:40px;position:absolute;bottom:15px;right:15px;z-index:3;outline:none!important;background:transparent!important;padding:0;border:0;box-sizing:border-box;box-shadow: 0 0 10px 1px rgb(0 0 0 / 40%);
border-radius:100%;cursor:pointer}
.isaSlider .isppBtn::before{content:'';display:block;width:100%;height:100%;border:5px solid rgba(255,255,255,0.3);border-radius:100%;opacity:0}
.isaSlider .isppBtn::after{content:'';position:absolute;top:0;left:0;width:100%;height:100%;background-image:url(data:image/png;base64,);background-size:80%;background-position:50% 50%;background-repeat:no-repeat}
.isaSlider .playing.isppBtn::after{background-image:url(data:image/png;base64,)}
.isaSlider .isppBtn svg{width:100%;height:100%;position:absolute;top:50%;left:50%;stroke:#fff;background-color:#263238;border-radius:100%;transform:translate(-50%,-50%) rotate(-90deg);pointer-events:none;z-index:0}
.isaSlider .isppBtn svg .progressPath{stroke-dasharray:615.752;stroke-dashoffset:615.752;stroke:#f57b32}
.isaSlider .slideContent .contrntInner{background:rgba(0,0,0,0.4);padding:30px;min-width:50%}
.isaSlider .slideContent .contrntInner h2{margin-bottom: 30px;}
.isaSlider .swiper-slide.swiper-slide-active .slideContent .contrntInner{animation-name:zoomIn;animation-duration:1s;animation-fill-mode:both;animation-delay:0}
.isaSlider .swiper-slide.swiper-slide-active h5{animation-name:fadeInDown;animation-duration:1s;animation-fill-mode:both;animation-delay:1s}
.isaSlider .swiper-slide.swiper-slide-active h2{animation-name:zoomIn;animation-duration:1s;animation-fill-mode:both;animation-delay:1s}
.isaSlider .swiper-slide.swiper-slide-active p{backface-visibility:visible!important;animation-name:flipInX;animation-duration:1s;animation-fill-mode:both;animation-delay:1s}
.isaSlider .swiper-slide.swiper-slide-active .btn-temp{animation-name:fadeInUpBig;animation-duration:1s;animation-fill-mode:both;animation-delay:1s}
.isaSlider .swiper-slide .collegeName{ position: absolute; text-align: right; bottom: 20px; right: 75px;font-size: 14px; text-transform: uppercase;letter-spacing: 1px; z-index: 9;}
.isaSlider .swiper-slide .collegeName a{ color: #fff; text-decoration: none; text-shadow: 1px 2px 6px rgb(0 0 0 / 40%); transition: all 0.4s ease; }
.isaSlider .swiper-slide .collegeName a:hover{ letter-spacing: 1.2px;}

.profile-content{ padding-bottom: 60px !important; }

.reviewBanner{ position: relative; margin-bottom: 70px;}
.reviewBanner .wrapper{ padding-bottom: 80px; padding-top: 40px;}
.reviewSearchBox{
    padding: 15px; background: #fff; max-width: 700px; width: 100%;
    position: absolute; left: 50%; bottom: -40px; transform: translateX(-50%);
    display: flex; 
}
.reviewSearchBox .crBox input{ display: none;}
.reviewSearchBox .crBox label{ margin: 0; padding: 10px 10px;  height: 50px; background: #f0f0f0; font-weight: 600;display: flex; align-items: center; transition: all 0.4s ease; color: #333;border: 1px solid #dfe1e5; cursor: pointer;}
.reviewSearchBox .crBox input:checked ~ label{ background: #f57b32; color: #fff; } 

.featureReviewCard{ text-decoration: none !important; color: #333;}
.featureReviewCard .ico{ width: 60px; height: 60px; line-height: 60px; text-align: center; font-size: 26px; border-radius: 50%; margin-right: 15px;}

.contactSection .infoPanel{ position: relative; padding-left: 55px; margin-bottom: 30px;}
.contactSection .infoPanel i{font-size:1.2rem;float:left;width:44px;height:44px;background:#e8522e; color:#fff;display:flex;justify-content:center;align-items:center;border-radius:50px;transition:all .3s ease-in-out; position: absolute; top: 0; left: 0;}
.contactSection .infoPanel h4{font-size:1.2rem;font-weight:500;margin-bottom:5px;}
.contactSection .infoPanel p{margin-bottom:0;font-size:1rem;color:#e8522e}
.socialLinks a{font-size:14px;display:inline-block;background:#1b1f4c;color:#fff;line-height:1;line-height:36px; border-radius: 50%; text-align:center;width:36px;height:36px;transition:.3s}
.socialLinks a + a{margin-left:5px;}
.socialLinks a:hover{background:#e8522e;color:#fff;text-decoration:none}


.accordionExample .card{border:none;border-radius:0;box-shadow:none;margin-bottom:10px;position:relative}
.accordionExample .card-header{padding:0;position:relative}
.accordionExample .card-header:before{content:"";width:40px;height:100%;background:#e8522e;position:absolute;top:0;left:0;z-index:1}
.accordionExample .card-header .btn{display:block;padding:10px 30px 10px 60px;background:#f5f5f5;font-size:1rem;letter-spacing:1px;color:#1b1f4c;overflow:hidden;position:relative; text-decoration: none; outline: none;}
.accordionExample .card-header .btn:before,.accordionExample .card-header .btn.collapsed:before,.accordionExample .card-header .btn:after,.accordionExample .card-header .btn.collapsed:after{content:"\f068";font-family:"Font Awesome 5 Free";font-weight:900;font-size:15px;color:#fff;position:absolute;top:50%;left:13px; transform: translateY(-50%); z-index:2;transition:all .3s ease}
.accordionExample .card-header .btn:after,.accordionExample .card-header .btn.collapsed:after{content:"\f067";transform: translateY(300%);}
.accordionExample .card-header .btn.collapsed:before{transform:translateY(-300%)}
.accordionExample .card-header .btn.collapsed:after{transform:translateY(-50%)}
.accordionExample .card-body{padding:10px 30px 10px 60px;background:#f5f5f5;border-top:none;font-size:15px;color:#6f6f6f;letter-spacing:1px;line-height:28px;position:relative}
.accordionExample .card-body:before{content:"";display:block;width:40px;height:100%;background:rgba(0,0,0,0.05);position:absolute;top:0;left:0}

