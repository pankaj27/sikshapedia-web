    function doScroll(to_append=false,_start=0){
    	// start += limit;
    	$.ajax({
        	type:'POST',
        	url:base_url+'filterdata',
        	data:{csrf_test_name:csrf_hash,_l:limit,_s:_start,_c:_c,_st:_st,_ct:_ct,_strm:_strm,_cu:_cu,_exam:_exam,_ctype:_ctype,_appr:_appr,_aff:_aff,_c_cate:_c_cate,_agn:_agn},
        	cache:false,
        	beforeSend:function(){
        		processing = true;
                $('#data_loader').html('<img src="'+loader_gif+'" height="50px">');
        	},
        	success:function(d){
        		if(d.html!=''){
                    

                    if(to_append==true){
                        $("#udata_lists").append(d.html);
                    }else if(to_append==false){
                        $("#udata_lists").html(d.html);
                    }
							
        			
        			
                    $(window).data('ajax_in_progress', false);
        		}

                console.log(start);
        	},
            complete:function(xhr,status){
                $('#data_loader').html('');
            }
        });
    }

    function doLoadData(l,s,_c,_st,_ct,_strm,_cu,_exam){
        // start += limit;
        $.ajax({
            type:'POST',
            url:base_url+'filterdata',
            data:{csrf_test_name:csrf_hash,_l:l,_s:s,_c:_c,_st:_st,_ct:_ct,_strm:_strm,_cu:_cu,_exam:_exam},
            cache:false,
            beforeSend:function(){
                processing = true;
            },
            success:function(d){
                if(d.html!=''){

                     $("#udata_lists").html(d.html);       
                    
                    
                    $(window).data('ajax_in_progress', false);
                }
            }
        });
    }
});