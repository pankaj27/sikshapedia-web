   function load_more(page=0) {
        $.ajax({
            url:base_url+'filterdata',
            type: "POST",
            dataType: "json",
            data:{csrf_test_name:csrf_hash,_l:limit,_s:page,_c:_c,_st:_st,_ct:_ct,_strm:_strm,_cu:_cu,_exam:_exam,_ctype:_ctype,_appr:_appr,_aff:_aff,_c_cate:_c_cate,_agn:_agn},
        }).done(function (d) {
            //console.log(d.html)

            //console.log($('#udata_lists').html().length);
            isLoading = false;
            if (d=='') {
                //if(d.length == 0){
                    isDataLoading = false;
                   $('#data_loader').hide();
                   action = 'active';
                    return;
                //}

                console.log('in if');
                    
            }else{
                console.log('in else');
                $('#data_loader').hide();
               $(window).data('ajax_in_progress', false);
                // if($('#udata_lists').html().length>0){
                //     $('#udata_lists').append(d.html).show('slow');
                // }else{
                //     $('#udata_lists').append(d.html).show('slow'); 
                //     action = 'inactive';
                // }

                $('#udata_lists').append(d.html).show('slow'); 
                action = 'inactive';
                
                
            }
               
            console.log(page);
        }).fail(function (jqXHR, ajaxOptions, thrownError) {
            console.log('No response');
        });
    }





