  $("#file_cover_image").change(function(e) {
      var file, img,img_height,img_width,allowed_file_size;

      if ((file = this.files[0])) {
          img = new Image();
          img.src = _URL.createObjectURL(file);
          img.onload = function() {            

              img_height=this.height;
              img_width=this.width;
              allowed_file_size=999500*7;
             
              if(img_height==480 && img_width==1920 && file.size<=allowed_file_size){

                $('#cover_img_small').attr('src', img.src);
                $('#cover_img_large').attr('src',img.src);

              }else{
                Toast.fire({
                  icon: 'error',
                  title: 'For the best results on all devices, use an image that’s at least 1920 x 480 pixels and 6MB or less.Selected file is '+img_width+'x'+img_height+' pixels and file size is '+file_size(file.size)
                });

              }

          };
          img.onerror = function() {
              alert( "not a valid file: " + file.type);
          };

      }

  });


  $("#file_logo_image").change(function(e) {
      var file, img,img_height,img_width,allowed_file_size;

      if ((file = this.files[0])) {
          img = new Image();
          img.src = _URL.createObjectURL(file);
          img.onload = function() {            

              img_height=this.height;
              img_width=this.width;
              allowed_file_size=999500*5;
             
              if(img_height>=500 && img_width>=500 && file.size<=allowed_file_size){

                $('.logo_image').attr('src', img.src);

              }else{
                Toast.fire({
                  icon: 'error',
                  title: 'For the best results on all devices, use an image that’s at least 500 x 500 pixels and 6MB or less.Selected file is '+img_width+'x'+img_height+' pixels and file size is '+file_size(file.size)
                });

              }

          };
          img.onerror = function() {
              alert( "not a valid file: " + file.type);
          };

      }

  });

  $('body').on('click','#btn_change_logo',function(){
    $('#file_logo_image').trigger('click');
  });


  $('body').on('click','#btn_change_cover_image',function(){
    $('#file_cover_image').trigger('click');
  });

  $('body').on('change','#register_institute_country',function(){
    var ccode=$('#register_institute_country :selected').val();
    const myArr = ccode.split("#");
    var country=myArr[0];
    $('#label_ph').html('Phone No ('+myArr[1]+')');
    
    console.log(myArr[1]);
    loadstates(country);
    loaduniversities(country);

    if(ccode!=''){
      $('#register_institute_country-error').html('').css('display','none');
    }
  });

  $('body').on('change','#register_institute_state',function(){

      var ccode=$('#register_institute_country :selected').val();
      const myArr = ccode.split("#");
      var country=myArr[0];
      var state=$('#register_institute_state :selected').val();
      console.log(state);
      loadcities(country,state);
      $("#register_institute_city").trigger("chosen:updated");
      if(state!=''){
        $('#register_state-error').html('').css('display','none');
      }
    });

    $('body').on('change','#register_city',function(){
      var ses=$('#register_institute_city :selected').val();

      if(ses!=''){
        $('#register_college_city-error').html('').css('display','none');
      }
    });


     function loadstates(c){
      var shtml='';

      $.getJSON(base_url+'get_states/'+c,function(data){
        if(data.status==false){
          shtml+='<option value="0">No State/Province Found</option>';
        }else{
          json_data=data.states;
          shtml='<option value="0">Select State/Province</option>';

          $.each(json_data,function(k,v){
            shtml+='<option value="'+v.state_id+'">'+v.state_name+'</option>';
          });
        }
          

          $('#register_institute_state').html(shtml);

         $("#register_institute_state").trigger("chosen:updated");
      });

      // $.ajax({
      //   type:'GET',
      //   url:wb_api+'coapi/country_states/'+c,
      //   data:{},
      //   beforeSend: function(){ 
      //     $("#register_college_state").empty(); 
      //   },
      //   success:function(d){
      //     $.each(d,function(k,v){
      //       shtml+='<option value="'+v['state_id']+'">'+v['state_name']+'</option>';
      //     });
          
      //     $('#register_college_state').html(shtml);

      //     console.log('state:'+d[0]['state_id']);

      //    $("#register_college_state").trigger("chosen:updated");
      //    //loadcities(c,d[0]['state_id']);
      //   }
      // });
    }

    function loadcities(c,s){
      var chtml='';

      $.getJSON(base_url+'get_cities/'+c+'/'+s,function(data){
        if(data.status==false){
          chtml+='<option value="0">No City Found</option>';
        }else{
          json_data=data.cities;
          chtml='<option value="0">Select City</option>';

          $.each(json_data,function(k,v){
            chtml+='<option value="'+v.city_id+'">'+v.city_name+'</option>';
          });
        }
          

        $('#register_institute_city').html(chtml);

        $("#register_institute_city").trigger("chosen:updated");
      });

      // $.ajax({
      //   type:'GET',
      //   url:wb_api+'coapi/state_cities/'+c+'/'+s,
      //   data:{},
      //   beforeSend: function(){ 
      //     $("#register_college_city").empty(); 
      //   },
      //   success:function(d){
      //     $.each(d.searched_data,function(k,v){
      //       chtml+='<option value="'+v['city_id']+'">'+v['city_name']+'</option>';
      //     });
          
      //     $('#register_college_city').html(chtml);

      //    $("#register_college_city").trigger("chosen:updated");
      //   }
      // });
    }


    function loaduniversities(c){
     
      var chtml='<option value="0">Select University</option>';

      $.ajax({
        type:'GET',
        url:wb_api+'instapi/universities/'+c,
        data:{},
        beforeSend: function(){ 
          $("#register_institute_university").empty(); 
        },
        success:function(d){
          $.each(d,function(k,v){
            chtml+='<option value="'+v['university_id']+'">'+v['university_name']+'</option>';
          });
          
          $('#register_institute_university').html(chtml);

         $("#register_institute_university").trigger("chosen:updated");
        }
      });
    }


  $('#form_user_branding').validate({
    rules:{
      file_logo_image:{
        required:true
      },
      file_cover_image:{
        required:true
      }
    },
    messages:{
      file_logo_image:{
        required:'Select logo'
      },
      file_cover_image:{
        valueNotEquals:'Select cover image'
      }
    },
    submitHandler:function(){
      var formData=new FormData($('#form_user_branding')[0]);
      //var change_type='';
      formData.append([csrf_name], csrf_hash);
      $.ajax({
          type:'POST',
          url:base_url+'update_single',
          data:formData,
          cache: false,
          contentType: false,
          processData: false,
          timeout: 60000000,
          target: '.preview',
          beforeSend:function(){
            $('#btn_publish').html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span><span class="sr-only">Saving...</span>').prop('disabled',true);
          },
          success:function(f){
            if(f.success){
             $('#btn_publish').prop('disabled',true);
             Toast.fire({
                icon: 'success',
                title: f.success
              });            
            }else if(f.error){
              $('#btn_save_ads').prop('disabled',true);
              Toast.fire({
                icon: 'error',
                title: f.error,
              });
            }else if(f.redirect){
              $('#btn_publish').prop('disabled',true);
              Toast.fire({
                icon: 'info',
                title: 'Your session expired'
              });
            }
          },
          xhr: function(){
              //Get XmlHttpRequest object
               var xhr = $.ajaxSettings.xhr() ;
              //Set onprogress event handler
               xhr.upload.onprogress = function(data){
                  var perc =(data.loaded / data.total) * 100;// Math.round((data.loaded / data.total) * 100);
                  $('.progress-bar').css('width',perc.toFixed(2) + '%').text(perc.toFixed(2) + '%');
               };
               return xhr ;
          },
          error: function (e) {
          },
          complete:function(status,xhr){
            $('.progress-bar').css('width', '0%').text('0%');
            $('#btn_publish').html('Publish').attr('disabled',false);
          },
          resetForm: true 
      });
    }
  });


  //Info Settings

  $('#form_info_settings').validate({
    rules:{
      registration_user_recovery_mail:{
        required:true,
        email:true
      },
      registration_user_recovery_phone:{
        required:true
      },
      registration_user_contact_person:{
        required:true
      },
      registration_user_current_pass:{
        required:false,
        minlength:8,
        maxlength:16,
        pwcheck:true
      },
      registration_user_new_pass:{
        required:false,
        minlength:8,
        maxlength:16,
        pwcheck:true
      }
    },
    messages:{
      registration_user_recovery_mail:{
        required:'Enter email address',
        email:'Email is not valid'
      },
      registration_user_recovery_phone:{
        required:'Enter phone no'
      },
      registration_user_contact_person:{
        required:'Enter contact person name'
      },
