    doScroll();

    function doScroll(){
    	start += limit;
    	$.ajax({
        	type:'POST',
        	url:base_url+'filterdata',
        	data:{csrf_test_name:csrf_hash,_l:limit,_s:start,_c:_c,_st:_st,_ct:_ct,_strm:_strm,_cu:_cu,_exam:_exam},
        	cache:false,
        	beforeSend:function(){
        		processing = true;
        	},
        	success:function(d){
        		if(d.html!=''){
							
        			$("#udata_lists").append(d.html);
        			processing = true;
                    $(window).data('ajax_in_progress', false);
        		}
        	}
        });
    }
