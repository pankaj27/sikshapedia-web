var units = ["B", "KB", "MB", "GB", "TB"];

    function file_size(size, unit) {

      var index_of_unit = units.indexOf(unit),
          coverted_size;

      if (index_of_unit === -1) {

          coverted_size = false;

      } else {

          while (index_of_unit > 0) {
              size *= 1024;
              index_of_unit -= 1;
          }

          coverted_size = size;
      }

      return coverted_size;
    };

jQuery(function($) {
