            html+='</div>';
            html+='<div class="card-body">';
              html+='<div class="form-row">';
              $.each(d,function(k,v){
              	html+='<div class="col-md-4">';
              
              
               html+='<div class="proBox">';
                  html+='<div class="imgBox">';
                    html+='<a href="'+v['access_url']+'"> <img class="" src="'+v['college_banner']+'" alt="'+v['college_name']+'"></a>';
        
                   // html+='<div class="pro-label pro-featured">';
                   //    html+='<span class="pro-label-bg">Featured <span class="pro-arrow"></span></span>';
                   //  html+='</div>';
