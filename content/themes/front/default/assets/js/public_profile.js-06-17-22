                        html+='<a class="compare-property" href="javascript:;" data-toggle="tooltip" title="Rating"><i class="far fa-star"></i></a>';
                      html+='</div>';
                      html+='<a class="pro-link" href="#"></a>';
                    html+='</div>';
                  html+='</div>';
                  html+='<div class="proBoxBody">';
                    html+='<div class="proInfo">';
                      html+='<div class="infoImg"><a href="'+v['access_url']+'"><img src="'+v['college_logo']+'" alt="'+v['college_name']+'"></a></div>';
                      html+='<p class="infoTitle"><a href="'+v['access_url']+'">'+v['college_name']+'</a></p>';
                      html+='<p class="infoLocation"><i class="fas fa-map-marker-alt"></i> '+v['college_city']+', '+v['college_state']+'</p>';
                    html+='</div>';

                    //  html+='<div class="p-3">';
                    //   html+='<h4 class="pro-title"><a href="#" > MBA/PGDM10 </a>  <span class="badge badge-warning">10</span></h4>';
                    //   html+='<div class="pro-price">TOTAL FEES  <span> ₹23.15 L </span> </div>';
                    //   html+='<div class="viewlink"><a href="#"> <i class="fas fa-long-arrow-alt-right"></i> <span> VIEW ALL COURSES & FEES </span></a> </div>';
                    // html+='</div>';
                    
                    html+='<div class="btnGroup">';
                      html+='<a href="#" class="apply"><i class="far fa-file-alt"></i> Apply Now</a>';
                      html+='<a href="#" class="download"><i class="fas fa-download"></i> Explore</a>';
                    html+='</div>';
                  html+='</div>';
              html+='</div>';
              
   
          html+='</div>';
              });
              html+='</div>';
            html+='</div>';
            html+='</div>';
			}

			$('#nearby_colleges').html(html);
		}
	});




	var html3='';

	$.ajax({
		type:'GET',
		url:wb_api+'newsapi/news/'+_cot,
		data:{},
		beforeSend:function(){

		},
		success:function(d){
			if(d!=null){
				console.log(d)
            $.each(d,function(k,v){
							html3+='<li class="list-group-item">';
		                html3+='<a href="'+v['news_link']+'" target="_blank" class="media">';
		                  html3+='<img src="'+v['news_banner']+'" width="40" class="mr-2" alt="..."> ';
		                  html3+='<div class="media-body">';
		                    html3+='<h6 class="mb-0 color2">'+v['news_heading']+'</h6>';
		                    html3+='<small>'+v['news_published_date']+'</small> ';
		                  html3+='</div>';
		                html3+='</a>';
		              html3+='</li>';

		            
            });
              
			}

			$('#news_list').html(html3);
		}
	});


	var html4='';

	$.ajax({
		type:'GET',
		url:wb_api+'instapi/courseslist/'+_cid+'/3',
		data:{},
		beforeSend:function(){

		},
		success:function(d){
			if(d!=null){
            $.each(d,function(k,v){
							html4+='<li class="list-group-item">';
		                html4+='<a href="#" class="media">';
		                  html4+='<div class="media-body">';
		                    html4+='<h6 class="mb-0 color2">'+v['course_name']+'</h6>';
		                    html4+='<small>'+v['course_duration']+'</small> ';
		                  html4+='</div>';
		                html4+='</a>';
		              html4+='</li>';

		            
            });
              
			}

			$('#college_courses_list').html(html4);
		}
	});

});