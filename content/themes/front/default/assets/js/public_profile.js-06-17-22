jQuery(function($) {
  "use strict";

  setTimeout(function(){ $('#reg2ApplyModal').modal({ show: true }); }, 3000);

  const Toast = Swal.mixin({
    toast: true,
    position: 'top',
    showConfirmButton: false,
    timer: 10000
  });


  $('body').on('click','#claim_this_college',function(){
  	$('#claiminstituteModal').find('#claim_institute').val($(this).attr('data-inst'));
  	$('#claiminstituteModal').find('#claim_institute_type').val($(this).attr('data-inst_type'));
  });


  $('#form_claim_for_college').validate({
  	rules:{
  		claimer_full_name:{
  			required:true
  		},
  		claimer_email:{
  			required:true,
  			email:true
  		},
  		claimer_ph:{
  			required:true,
  			digits:true
  		}
  	},
  	messages:{
  		claimer_full_name:{
  			required:'Please enter your name'
  		},
  		claimer_email:{
  			required:'Please enter your email',
  			email:'Email id is not valid'
  		},
  		claimer_ph:{
  			required:'Please enter your mobile number',
  			digits:'Only digits are allowed'
  		}
  	},
  	submitHandler:function(){
  		var f_data = FormDataJson.formToJson(document.getElementById("form_claim_for_college"));
      	var ctext= CryptoJS.AES.encrypt(JSON.stringify(f_data), _xtYu, { format: CryptoJSAesJson }).toString();
  		$.ajax({
  			type:"POST",
  			url:base_url+'claiminstitute',
  			data: {ctext:ctext,csrf_test_name:csrf_hash},
	        cache:false,
  			beforeSend:function(){
	          $('#btn_submit_claim').html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>').prop('disabled',true);
	        },
	        success:function(d,status,xhr){
	          if(d.success){
	          	$('#h4_verify_text').html('Verify email address');
	          	$('#span_verify_text').html(d.success);
	          	$('#form_claim_for_college_verify').css('display','block');
	          	$('#form_claim_for_college').css('display','none');
	          	$('#btn_submit_claim').html('Submit').prop('disabled',false);
	          }else{
	          	Toast.fire({
                  icon: 'error',
                  title: d.error
              });
	            $('#btn_submit_claim').html('Submit').prop('disabled',false);
	          }
	        },
	        error: function( jqXhr ) {
	            $('#btn_submit_claim').html('Submit').prop('disabled',false);
	        },
	        complete:function(status,xhr){
	         $('#btn_submit_claim').html('Submit').prop('disabled',false);
           //$('#claiminstituteModal').modal('hide');
	        }
  		});
  	}
  });

  $('#form_claim_for_college_verify').validate({
  	rules: {
        "claim_otp_value[]": "required"
    },
    messages: {
        "claim_otp_value[]": "Wrong OTP"
    },
    submitHandler:function(){
  		var f_data = FormDataJson.formToJson(document.getElementById("form_claim_for_college_verify"));
      	var ctext= CryptoJS.AES.encrypt(JSON.stringify(f_data), _xtYu, { format: CryptoJSAesJson }).toString();
  		$.ajax({
  			type:"POST",
  			url:base_url+'claiminstitute',
  			data: {ctext:ctext,csrf_test_name:csrf_hash},
	        cache:false,
  			beforeSend:function(){
	          $('#btn_submit_claim_verify').html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>').prop('disabled',true);
	        },
	        success:function(d,status,xhr){
	          if(d.success){
	          	$('#h4_verify_text').html('Claim this college');
	          	$('#span_verify_text').html('You\'ll receive a 4 digit code in your email address and mobile no. to verify next');
	          	$('#form_claim_for_college_verify').css('display','none');
	          	$('#form_claim_for_college').css('display','block');
	          	$('#btn_submit_claim_verify').html('Submit').prop('disabled',false);

	          	$('#form_claim_for_college_verify')[0].reset();
	          	$('#form_claim_for_college')[0].reset();

	          	$('#claiminstituteModal').modal('hide');
	          }else{
	          	$('#otp_error').html(d.error);
	            $('#btn_submit_claim_verify').html('Submit').prop('disabled',false);
	          }
	        },
	        error: function( jqXhr ) {
	            //$('#btn_submit_claim').html('Submit').prop('disabled',false);
	        },
	        complete:function(status,xhr){
	         //$('#btn_submit_claim').html('Submit').prop('disabled',false);
	        }
  		});
  	}
  });


 //  	$('.claim_otp_value:first').keydown(function (event) {
	//     // check for hyphen
	//     if (event.which === 189) {
	//         event.preventDefault();
	//         $(this).next('.claim_otp_value').focus();
	//     }
	// });

		// $('input').keyup(function(){
