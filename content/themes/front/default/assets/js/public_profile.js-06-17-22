                    // html+='<div class="proReview">';
                    //   html+='<i class="far fa-envelope"></i> <b>20</b> ';
                    // html+='</div>';
                    html+='<div class="proRating">';
                      html+='<small class="d-block">RATING</small>';
                      html+='<i class="fas fa-star-half-alt"></i> <b>6.7/10</b> ';
                    html+='</div>';
                    html+='<div class="pro-action">';
                      html+='<div class="pro-action-inner">';
                       html+='<div class="social-share" data-toggle="tooltip" title="Share">';
                          html+='<div class="social-share-hover">';
                            html+='<i class="fa fa-share-alt"></i>';
                            html+='<div class="social-share-list">';
                              html+='<div class="list-social-icon clearfix">';
