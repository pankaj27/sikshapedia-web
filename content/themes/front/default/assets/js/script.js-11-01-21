 // ISA SLIDER JS
 var slideDuration = 5000,
      progressPath = $('.isppBtn .progressPath'), 
      len = 2 * Math.PI * progressPath.attr('r');


if($('.isaSlider').length>0){
  var isaSlider = new Swiper(".isaSlider", {
      watchOverflow: true,
      watchSlidesVisibility: true,
      watchSlidesProgress: true,
      preventInteractionOnTransition: true,
      grabCursor: true,
      loop: true,
      autoplay: { delay: slideDuration},
      navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
      },
      effect: 'slide',
      pagination: {
          el: '.swiper-pagination',
          type: 'progressbar',
      },
      on: {
          beforeInit: function () {
              progressPath.stop().animate({'stroke-dashoffset': 0}, slideDuration);
              
          },
          activeIndexChange : function () {
              progressPath.css({ "stroke-dashoffset": len });
              progressPath.stop().animate({'stroke-dashoffset': 0}, slideDuration);
          }
      }

  });
}
  
  $('.isppBtn').click(function(){
      if ($(this).hasClass("playing")) {
          $(this).removeClass('playing');
          isaSlider.autoplay.stop();
          progressPath.animate().stop();
          progressPath.css({ "stroke-dashoffset": len });
      }else{
          $(this).addClass('playing');
          isaSlider.autoplay.start();
          progressPath.stop().animate({'stroke-dashoffset': 0}, slideDuration);
      }
  });
  $('.swiper-button-next,.swiper-button-prev').on("click", function(){
      isaSlider.autoplay.start();
  }); 


})(jQuery);



jQuery(document).ready(function($){

   jQuery(window).on('load', function() {
      jQuery("#preloader .loaderIcon").fadeOut();
      jQuery("#preloader").delay(350).fadeOut("slow");
  });
    
  // $('.select2').select2({
  //     theme: 'bootstrap4',
  // });

  var ww = $(window).width();

  if (ww <= 1140 && ww > 960) {
    $('body').addClass('screen_lg');
    $('body').removeClass('screen_md screen_sm screen_xs screen_xl');
  }else if(ww <= 960 && ww > 720) {
    $('body').addClass('screen_md');
    $('body').removeClass('screen_lg screen_sm screen_xs screen_xl');
  }else if(ww <= 720 && ww > 540) {
    $('body').addClass('screen_sm');
    $('body').removeClass('screen_lg screen_md screen_xs screen_xl');
  }else if(ww < 540) {
    $('body').addClass('screen_xs');
    $('body').removeClass('screen_lg screen_md screen_sm screen_xl');
  }else {
    $('body').addClass('screen_xl');
    $('body').removeClass('screen_lg screen_md screen_sm screen_xs');
  }

