  $("#subscriber_course").chosen({no_results_text: "Select Course .....",include_group_label_in_selected:true});

    $.getJSON(base_url+'get_courses',function(data){
      json_data=data.searched_data;
      var course_html='';
      $.each(json_data,function(k,v){
        course_html+='<optgroup label="'+k+'">';
        $.each(v,function(_k,_v){
          course_html+='<option value="'+_v.course_id+'">'+_v.course_name+' [ '+_v.course_short_name+' ]</option>';
        });
          
          course_html+='</optgroup>';
         });

         $('#subscriber_course').html(course_html);
         $("#subscriber_course").trigger("chosen:updated");
    });

  $.validator.addMethod("valueNotEquals", function(value, element, arg){
    return arg !== value;
  }, "Value must not equal arg.");

  $('#form_subscription').validate({
    rules:{
      subscriber_email:{
        required:true,
        email:true
      },
      subscriber_phone:{
        required:true,
        digits:true
      },
      subscriber_course:{
        required:true,
        valueNotEquals:'0'
      }
    },
    messages:{
      subscriber_email:{
        required:'Enter email address',
        email:'Email is not valid'
      },
      subscriber_phone:{
        required:'Enter phone no'
      },
      subscriber_course:{
        required:'Please select in course you are interested in',
        valueNotEquals:'Please select course'
      }
    },
    submitHandler:function(){
      var f_data = FormDataJson.formToJson(document.getElementById("form_subscription"));
      var ctext= CryptoJS.AES.encrypt(JSON.stringify(f_data), _xtYu, { format: CryptoJSAesJson }).toString();
      var _msg='';

      $.ajax({
        type:'POST',
        url:base_url+'subscribe',
        data: {ctext:ctext,csrf_test_name:csrf_hash,page:page},
        cache:false,
        beforeSend:function(){
          $('#subscriber_email').prop('disabled',true);
          $('#subscriber_phone').prop('disabled',true);
          $('#btn_subscribe_newsletter').html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>').prop('disabled',true);
        },
        success:function(d,status,xhr){
          if(d.success){

            _msg+='<h6 class="text-center mb-3">'+d.success+'</h6>';

            if(d.colleges!=''){

              _msg+='<h6 class="text-center mb-3">Colleges offering same course you might be interested</h6>';

              _msg+='<hr>';
              _msg+='<div class="row form-row">';

              $.each(d.colleges,function(k,v){
                _msg+='<div class="col-lg-4">';
                        _msg+='<div class="card shadow-sm">';
                          _msg+='<div class="position-relative">';
                            _msg+='<img src="'+v['college_banner']+'" class="card-img" alt="'+v['college_name']+'" style="height: 150px !important;">';
                            _msg+='<div class="card-img-overlay d-flex  p-2">';
                              _msg+='<div class="align-self-end">';
                                _msg+='<a href="'+v['access_url']+'"> <img src="'+v['college_logo']+'" class="w-40" alt="" style="height:30px !important;"></a>';
                                _msg+='<h6 class="m-0 f12"><a href="'+v['access_url']+'" class="text-white">'+v['college_name']+'</a></h6>';
                                _msg+='<p class="m-0 f10 text-white"><i class="fa fa-map-marker"></i> '+v['college_city']+','+v['college_state']+' </p>';
                              _msg+='</div>';
                            _msg+='</div>';
                          _msg+='</div>';
                          _msg+='<div class="card-body p-2">';
                            _msg+='<div class="d-flex justify-content-between align-items-center">';
                              _msg+='<div class="">';
                                _msg+='<h6 class="m-0 f12">'+v['college_course_full_name']+' </h6>';
                                _msg+='<p class="m-0 f10"><span class="color2">[ '+v['college_course_short_name']+' ]</span></p>';
                              _msg+='</div>';
                              _msg+='<div class="">';
                                _msg+='<a href="'+v['access_url']+'" class="btn btn-primary btn-sm">Explore</a>';
                              _msg+='</div>';
                            _msg+='</div>';
                          _msg+='</div>';
                        _msg+='</div>';
                      _msg+='</div>';
              });

              
              _msg+='</div>'
            }
              

            $('#subscriptionthankYouModal .modal-body').html(_msg);

            
          }else{
            $('#subscriptionthankYouModal .modal-body').html('<h6 class="text-center mb-3">'+d.error+'</h6>');
          }

          $('#subscriptionthankYouModal').modal('show');
        },
        complete:function(xhr,status){
          $('#subscriber_email').prop('disabled',false).val('');
          $('#subscriber_phone').prop('disabled',false).val('');
          $('#btn_subscribe_newsletter').html('Submit').prop('disabled',false);
        }
      });
    }
  });

