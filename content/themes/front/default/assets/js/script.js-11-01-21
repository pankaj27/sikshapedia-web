    $('body').on('change','#register_country',function(){
      var ccode=$('#register_country :selected').val();
      const myArr = ccode.split("#");
      var country=myArr[0];
      $('#label_ph').html('Phone No ('+myArr[1]+')');
      
      console.log(myArr[1]);
      loadstates(country);
      loaduniversities(country);

      if(ccode!=''){
        $('#register_country-error').html('').css('display','none');
      }
    });

    $('body').on('change','#register_state',function(){

