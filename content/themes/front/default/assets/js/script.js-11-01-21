    function loadstates(c){
      var shtml='<option value="">Select State/Province</option>';

      $.ajax({
        type:'GET',
        url:'https://api.waytoadmissions.com/v1/coapi/country_states/'+c,
        data:{},
        beforeSend: function(){ 
          $("#register_state").empty(); 
        },
        success:function(d){
          $.each(d,function(k,v){
            shtml+='<option value="'+v['state_id']+'">'+v['state_name']+'</option>';
          });
          
          $('#register_state').html(shtml);

          console.log('state:'+d[0]['state_id']);

         $("#register_state").trigger("chosen:updated");
         //loadcities(c,d[0]['state_id']);
        }
      });
    }

    function loadcities(c,s){
      var chtml='<option value="0">Select City</option>';

      $.ajax({
        type:'GET',
        url:'https://api.waytoadmissions.com/v1/coapi/state_cities/'+c+'/'+s,
        data:{},
        beforeSend: function(){ 
          $("#register_city").empty(); 
        },
        success:function(d){
          $.each(d.searched_data,function(k,v){
            chtml+='<option value="'+v['city_id']+'">'+v['city_name']+'</option>';
          });
          
          $('#register_city').html(chtml);

         $("#register_city").trigger("chosen:updated");
        }
      });
    }


    function loaduniversities(c){
     
      var chtml='<option value="0">Select University</option>';

      $.ajax({
        type:'GET',
        url:'https://api.waytoadmissions.com/v1/instapi/universities/'+c,
        data:{},
        beforeSend: function(){ 
          $("#register_university").empty(); 
        },
        success:function(d){
          $.each(d,function(k,v){
            chtml+='<option value="'+v['university_id']+'">'+v['university_name']+'</option>';
          });
          
          $('#register_university').html(chtml);

         $("#register_university").trigger("chosen:updated");
        }
      });
    }

  
  
