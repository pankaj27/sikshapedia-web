<section class="commonSec topExmSec" style="background-color:#fca300">
    <div class="wrapper container container-top top-courses">
      <div class="section-title text-white">
        <h2 style="color:white;">Top Courses</h2>
      </div>
      <div class="btnGroup text-center text-center list-unstyled d-flex justify-content-center align-items-center flex-wrap" id="top_sourses_section">

        <?php
        if(!empty($top_courses)){
            foreach ($top_courses as $key => $value) {
                ?>
                <a href="<?php echo $value['course_college_url'];?>" class="btn btn-outline-primary" style="border: 1px solid #fff;color:white; border-radius: 50px;padding: 6px 12px;font-size: 12.352 !important;"><?php echo $value['course_name'];?></a>
                <?php
            }
        }
        ?>
      </div>

    </div>
  </section>

  <script type="text/javascript">
      $(document).ready(function(){

        $.getJSON(wb_api+'capi/courseslist', '', function (data, textStatus, jqXHR){
            var top_courses_section='';

            $.each(data.top_courses,function(k,v){
                top_courses_section+='<a href="'+v.course_college_url+'" class="btn btn-outline-primary" style="border: 1px solid #fff;color:white; border-radius: 50px;padding: 6px 12px;font-size: 12.352 !important;">'+v.course_name+'</a>';
            });

            $('#top_sourses_section').html(top_sourses_section);
        });
      });
  </script>

