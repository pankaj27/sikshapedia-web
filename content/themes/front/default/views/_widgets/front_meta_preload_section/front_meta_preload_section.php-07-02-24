		    margin: 0 !important; /* Remove default margin */
		    max-width: 100%; /* Set the modal width to 100% of the screen */
		    height: 100%; /* Set the modal height to 100% of the screen */
		  }

		  .modal-content {
		    min-height: 100%; /* Ensure the modal content takes up the full height */
		    border: none; /* Remove the border (optional) */
