<?php
if(!empty($banners)){
  ?>

<section class="swiper-container isaSlider">
    <div class="swiper-wrapper">

        <?php
        $i=0;
        foreach ($banners as $key => $value) {
        ?>

        <div class="swiper-slide">
            <img src="<?php echo $value['banner_image'];?>" alt="<?php echo $value['banner_title'];?>">

            <!-- <h4 class="collegeName"><a href="#">College name goes here</a></h4> -->

            <?php
            if(!empty($value['banner_title'])){
                ?>
                <div class="slideContent">
                    <div class="contrntInner">
                        <h2 class=""> <?php echo $value['banner_title'];?> </h2>
                        <?php
                        if(!empty($value['banner_sub_title'])){
                            ?>
                            <p class=""><?php echo $value['banner_sub_title'];?></p>
                            <?php
                        }

                        if(!empty($value['access_url'])){
                            ?>
                            <a href="<?php echo $value['access_url'];?>" class="btn-temp btn-orange">Explore All</a> 
                            <?php
                        }
                        ?>

                        
                        
                    </div>
                </div>
                <?php
            }
            ?>
                
        </div>

        <?php
            $i++;
        }
        ?>

    </div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
    <div class="swiper-pagination"></div>
    <button class="isppBtn playing">
        <svg viewBox="0 0 200 200">
            <circle class="" stroke="#fff" fill="none" stroke-width="10" cx="100" cy="100" r="100" />
            <circle class="progressPath" stroke="#f57b32" fill="none" stroke-width="15" cx="100" cy="100" r="98" />
        </svg>
    </button>
</section>


