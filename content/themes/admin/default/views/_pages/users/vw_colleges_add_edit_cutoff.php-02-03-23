		foreach($college_data['college_cutoff_rounds'] as $k => $v){
			?>
			cutoff_round+='<option value="<?php echo $v->cutoff_round;?>"><?php echo $v->cutoff_round;?></option>';
			<?php
		}
		?>


		var cutoff_course='';

		<?php
		if(!empty($college_data['college_courses'])){
			foreach ($college_data['college_courses'] as $key => $value){
				?>
				cutoff_course+='<option value="<?php echo $value->course_id;?>"><?php echo $value->course_name;?></option>';
				<?php
			}
		}
		?>
	</script>


<script type="text/javascript">var _college='<?php echo (!empty($college_data))?$college_data['college_id']:'';?>';</script>


